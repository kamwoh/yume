[gd_scene load_steps=3 format=3]

; Sokoban — top-down 2D grid. v0.1 foundation only (no conditional movement
; yet). Camera centered at level 1's grid center: 5x5 cells × 32px = 160px,
; center = (80, 80).

[ext_resource type="Script" path="res://scripts/engine/world.gd" id="1"]
[ext_resource type="Script" path="res://scripts/engine/game_shell.gd" id="2"]

[node name="World" type="Node"]
script = ExtResource("1")
data_root = "res://data/demo_sokoban"
auto_start = true
verbose = true
renderer_script = "res://scripts/renderer_2d/entity_sprite_2d.gd"
; Sokoban is turn-based: one cell per keypress. Override engine defaults
; (which put move_* in the HOLD list for shooter-style continuous motion)
; so movement fires once on press-edge instead of every frame held.
input_actions_hold = PackedStringArray()
input_actions_press = PackedStringArray("move_north", "move_south", "move_east", "move_west", "restart")
stop_action_on_idle = ""

[node name="GameShell" type="Node" parent="."]
script = ExtResource("2")

[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(80, 80)
zoom = Vector2(2, 2)

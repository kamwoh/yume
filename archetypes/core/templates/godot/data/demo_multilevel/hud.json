{
  "_comment": "Multi-level HUD: shows current level + cleared count. Win when all_levels_complete reaches 1.",

  "panels": [
    {
      "anchor": "top-left",
      "elements": [
        {"type": "label", "binds": "world.current_level", "format": "🚪 {}", "size": 22},
        {"type": "spacer", "height": 4},
        {"type": "label", "binds": "player.cleared", "format": "Cleared: {}", "size": 18}
      ]
    }
  ],

  "controls_hint": "WASD walk · Reach the green goal\nR restart · Q quit",

  "win":  {"binds": "world.all_levels_complete", "op": ">=", "value": 1,
           "message": "🌟 ALL CHAMBERS CLEARED 🌟\nLast Marine endures."},
  "lose": {"binds": "player.hp", "op": "<=", "value": 0, "sustained": 1,
           "message": "💀 KIA 💀\n[R] retry · [Q] quit"}
}

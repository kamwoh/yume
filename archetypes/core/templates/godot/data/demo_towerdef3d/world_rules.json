{
  "_comment": "TowerDef3D rules. Categories: clock+waves, path-following, combat, base damage. Waves advance via wave_clock.enemies_alive counter (incremented on spawn, decremented on death/leak). wave_timer is the CONTINUOUS countdown to next wave — visible in HUD.",

  "rules": [

    {
      "_comment": "=== CLOCK + WAVES ===",
      "id": "clock_advance",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["wave_clock"]},
      "effect": [
        {"type": "state_add", "target": "self", "field": "wave_timer", "amount": -0.1},
        {"type": "state_add", "target": "self", "field": "spawn_cooldown", "amount": -0.1}
      ]
    },

    {
      "_comment": "Advance to next wave when timer ≤ 0 AND no pending spawns AND no enemies alive. Increments wave, sets new wave_size, resets timer to 8s for next inter-wave countdown.",
      "id": "wave_advance",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["wave_clock"],
                "state": {"wave_timer_lte": 0.0,
                          "enemies_to_spawn_lte": 0,
                          "enemies_alive_lte": 0}},
      "effect": [
        {"type": "state_add", "target": "self", "field": "wave", "amount": 1},
        {"type": "state_set", "target": "self", "field": "enemies_to_spawn",
         "value": "self.state.wave * 2 + 1"},
        {"type": "state_set", "target": "self", "field": "wave_timer", "value": 8.0}
      ]
    },

    {
      "_comment": "Spawn one enemy per spawn_cooldown tick. Increment enemies_alive (decremented on death/leak — drives wave_advance gate). 80% imp; the 20% demon path is the wave_promote_to_demon rule that fires on spawn-trigger.",
      "id": "wave_spawn_one",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["wave_clock"],
                "state": {"spawn_cooldown_lte": 0.0, "enemies_to_spawn_gt": 0}},
      "effect": [
        {"type": "spawn", "template": "enemy_grunt",
         "position": [-9, 0, -7],
         "overrides": {"state": {"velocity": [2.0, 0, 0]}}},
        {"type": "state_add", "target": "self", "field": "enemies_to_spawn", "amount": -1},
        {"type": "state_add", "target": "self", "field": "enemies_alive", "amount": 1},
        {"type": "state_set", "target": "self", "field": "spawn_cooldown", "value": 0.4}
      ]
    },

    {
      "_comment": "20% chance: just-spawned grunt becomes a demon (slower, tankier). Spawn-trigger fires synchronously after spawn effect commits; query 'grunt' tag matches the new entity.",
      "id": "wave_promote_to_demon",
      "trigger": {"type": "spawn"},
      "query": {"tags_all": ["grunt"]},
      "chance": 0.2,
      "effect": {"type": "transform", "target": "self", "to": "enemy_demon"}
    },

    {
      "_comment": "=== PLAYER BUILDS — press 1/2/3/4 to drop a basic tower. Slot levels: 0=ghost, 1=basic, 2=advanced. Build only fires when slot is at level 0 (ghost still present).",
      "id": "build_slot_1",
      "trigger": {"type": "input", "action": "build_1"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 50, "slot_1_level_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "tower_basic",
         "overrides": {"_forced_id": "tower_1"},
         "position": [-6, 0, -4]},
        {"type": "remove", "target": "ghost_1"},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -50},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"},
        {"type": "state_set", "target": "self", "field": "slot_1_level", "value": 1}
      ]
    },
    {
      "id": "build_slot_2",
      "trigger": {"type": "input", "action": "build_2"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 50, "slot_2_level_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "tower_basic",
         "overrides": {"_forced_id": "tower_2"},
         "position": [0, 0, -3]},
        {"type": "remove", "target": "ghost_2"},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -50},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"},
        {"type": "state_set", "target": "self", "field": "slot_2_level", "value": 1}
      ]
    },
    {
      "id": "build_slot_3",
      "trigger": {"type": "input", "action": "build_3"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 50, "slot_3_level_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "tower_basic",
         "overrides": {"_forced_id": "tower_3"},
         "position": [6, 0, 4]},
        {"type": "remove", "target": "ghost_3"},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -50},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"},
        {"type": "state_set", "target": "self", "field": "slot_3_level", "value": 1}
      ]
    },
    {
      "id": "build_slot_4",
      "trigger": {"type": "input", "action": "build_4"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 50, "slot_4_level_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "tower_basic",
         "overrides": {"_forced_id": "tower_4"},
         "position": [0, 0, 4]},
        {"type": "remove", "target": "ghost_4"},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -50},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"},
        {"type": "state_set", "target": "self", "field": "slot_4_level", "value": 1}
      ]
    },

    {
      "_comment": "=== PLAYER UPGRADES — press 5/6/7/8 to upgrade slot 1-4 from basic to advanced (level 1 → 2). Cost 100 gold. Removes the basic tower and spawns a tower_advanced at the same position.",
      "id": "upgrade_slot_1",
      "trigger": {"type": "input", "action": "build_5"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 100, "slot_1_level_eq": 1}},
      "effect": [
        {"type": "remove", "target": "tower_1"},
        {"type": "spawn", "template": "tower_advanced",
         "overrides": {"_forced_id": "tower_1"},
         "position": [-6, 0, -4]},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -100},
        {"type": "emit_shell_event", "event": "play_sound", "name": "upgrade"},
        {"type": "state_set", "target": "self", "field": "slot_1_level", "value": 2}
      ]
    },
    {
      "id": "upgrade_slot_2",
      "trigger": {"type": "input", "action": "build_6"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 100, "slot_2_level_eq": 1}},
      "effect": [
        {"type": "remove", "target": "tower_2"},
        {"type": "spawn", "template": "tower_advanced",
         "overrides": {"_forced_id": "tower_2"},
         "position": [0, 0, -3]},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -100},
        {"type": "emit_shell_event", "event": "play_sound", "name": "upgrade"},
        {"type": "state_set", "target": "self", "field": "slot_2_level", "value": 2}
      ]
    },
    {
      "id": "upgrade_slot_3",
      "trigger": {"type": "input", "action": "build_7"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 100, "slot_3_level_eq": 1}},
      "effect": [
        {"type": "remove", "target": "tower_3"},
        {"type": "spawn", "template": "tower_advanced",
         "overrides": {"_forced_id": "tower_3"},
         "position": [6, 0, 4]},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -100},
        {"type": "emit_shell_event", "event": "play_sound", "name": "upgrade"},
        {"type": "state_set", "target": "self", "field": "slot_3_level", "value": 2}
      ]
    },
    {
      "id": "upgrade_slot_4",
      "trigger": {"type": "input", "action": "build_8"},
      "query": {"tags_all": ["player"],
                "state": {"gold_gte": 100, "slot_4_level_eq": 1}},
      "effect": [
        {"type": "remove", "target": "tower_4"},
        {"type": "spawn", "template": "tower_advanced",
         "overrides": {"_forced_id": "tower_4"},
         "position": [0, 0, 4]},
        {"type": "state_add", "target": "self", "field": "gold", "amount": -100},
        {"type": "emit_shell_event", "event": "play_sound", "name": "upgrade"},
        {"type": "state_set", "target": "self", "field": "slot_4_level", "value": 2}
      ]
    },

    {
      "_comment": "=== PATH-FOLLOWING ===",
      "_": "Enemy contacts a waypoint → set velocity to that waypoint's stored next_v. Waypoint encodes the direction to the NEXT waypoint, so the enemy turns at each corner.",
      "id": "enemy_advance_at_waypoint",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["enemy"]},
        "b": {"tags_all": ["waypoint"]},
        "radius": 0.8
      },
      "effect": {
        "type": "velocity_set",
        "target": "a",
        "x": "b.state.next_vx",
        "y": 0,
        "z": "b.state.next_vz"
      }
    },

    {
      "_comment": "=== TOWER COMBAT ===",
      "_": "Tower cooldown ticks down each frame.",
      "id": "tower_cooldown_tick",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["tower"]},
      "effect": {"type": "state_add", "target": "self", "field": "cooldown", "amount": -0.1}
    },

    {
      "_": "Tower fires at first enemy in range when cooldown ≤ 0.",
      "id": "tower_fires",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["tower"], "state": {"cooldown_lte": 0.0}},
        "b": {"tags_all": ["enemy"]},
        "radius": 6.0
      },
      "effect": [
        {"type": "spawn", "template": "projectile",
         "position": ["a.state.position.x", 0.6, "a.state.position.z"],
         "overrides": {"state": {"velocity": [
           "(b.state.position.x - a.state.position.x) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 1) * 14",
           0,
           "(b.state.position.z - a.state.position.z) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 1) * 14"
         ]}}},
        {"type": "state_set", "target": "a", "field": "cooldown", "value": "a.properties.fire_cooldown"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "shoot"}
      ]
    },

    {
      "_": "Projectile damages enemy on contact.",
      "id": "projectile_hits_enemy",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["projectile"]},
        "b": {"tags_all": ["enemy"]},
        "radius": 0.6
      },
      "effect": [
        {"type": "state_add", "target": "b", "field": "hp", "amount": -1},
        {"type": "remove", "target": "a"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "hit"}
      ]
    },

    {
      "_": "Enemy death: hp ≤ 0 → 4 sparks, shake, +5 gold, decrement enemies_alive, remove.",
      "id": "enemy_death",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["enemy"], "state": {"hp_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.6, "self.state.position.z"],
         "overrides": {"state": {"velocity": [1.5, 1.0, 1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.6, "self.state.position.z"],
         "overrides": {"state": {"velocity": [-1.5, 1.0, 1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.6, "self.state.position.z"],
         "overrides": {"state": {"velocity": [1.5, 1.0, -1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.6, "self.state.position.z"],
         "overrides": {"state": {"velocity": [-1.5, 1.0, -1.5]}}},
        {"type": "emit_shell_event", "event": "shake", "intensity": 0.05, "duration": 6},
        {"type": "emit_shell_event", "event": "play_sound", "name": "kill"},
        {"type": "state_add", "target": "player", "field": "gold", "amount": 5},
        {"type": "state_add", "target": "clock_1", "field": "enemies_alive", "amount": -1},
        {"type": "remove", "target": "self"}
      ]
    },

    {
      "_comment": "=== BASE DAMAGE ===",
      "_": "Enemy reaches base → -1 base.hp, shake, decrement enemies_alive, remove enemy.",
      "id": "enemy_at_base",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["enemy"]},
        "b": {"tags_all": ["base"]},
        "radius": 0.8
      },
      "effect": [
        {"type": "state_add", "target": "b", "field": "hp", "amount": -1},
        {"type": "emit_shell_event", "event": "shake", "intensity": 0.08, "duration": 8},
        {"type": "emit_shell_event", "event": "play_sound", "name": "hurt"},
        {"type": "state_add", "target": "clock_1", "field": "enemies_alive", "amount": -1},
        {"type": "remove", "target": "a"}
      ]
    }
  ]
}

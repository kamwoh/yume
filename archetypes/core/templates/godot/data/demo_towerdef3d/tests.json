{
  "_comment": "Game-specific tests for towerdef3d. Tier 2.6s scenarios.",

  "scenarios": [
    {
      "name": "clock_advance_works",
      "_": "After 50 ticks: wave_timer was 3.0, ticked down to <0 at t31, wave_advance fired (wave 0→1, enemies_to_spawn=3, wave_timer=8). Then 19 more ticks of decrement: 8 - 1.9 ≈ 6.1.",
      "setup": {},
      "actions": [],
      "ticks": 50,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "clock_1",
         "field": "state.wave", "op": "==", "value": 1},
        {"type": "entity_field", "select": "by_id", "id": "clock_1",
         "field": "state.wave_timer", "op": "<", "value": 8.0},
        {"type": "entity_field", "select": "by_id", "id": "clock_1",
         "field": "state.wave_timer", "op": ">", "value": 5.0}
      ]
    },

    {
      "name": "wave_progression_after_long_run",
      "_": "After 244 ticks (~24s) with NO towers built, all wave 1 enemies leak to base. base.hp should have dropped by at least 3 (full wave 1 leak).",
      "setup": {},
      "actions": [],
      "ticks": 244,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "base_1",
         "field": "state.hp", "op": "<", "value": 8}
      ]
    },

    {
      "name": "build_tower_at_slot_1",
      "_": "Press 1 (build_1) on tick 1 → tower_1 spawns at slot 1, ghost_1 removed, gold -=50.",
      "setup": {},
      "actions": [{"tick": 1, "input": "build_1"}],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 50},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.slot_1_level", "op": "==", "value": 1},
        {"type": "entity_count", "query": {"tags_all": ["tower"]},
         "op": "==", "value": 1},
        {"type": "entity_count", "query": {"tags_all": ["slot_ghost"]},
         "op": "==", "value": 3}
      ]
    },

    {
      "name": "build_blocked_when_no_gold",
      "_": "Set player gold to 30 (< 50). Pressing build_1 should do nothing — query gold_gte 50 fails.",
      "setup": {
        "entity_state": {"player": {"gold": 30}}
      },
      "actions": [{"tick": 1, "input": "build_1"}],
      "ticks": 3,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["tower"]},
         "op": "==", "value": 0},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 30}
      ]
    },

    {
      "name": "build_blocked_at_same_slot",
      "_": "Build slot 1 twice in a row. Second press should fail: slot already built.",
      "setup": {},
      "actions": [
        {"tick": 1, "input": "build_1"},
        {"tick": 2, "input": "build_1"}
      ],
      "ticks": 4,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["tower"]},
         "op": "==", "value": 1},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 50}
      ]
    },

    {
      "name": "upgrade_slot_1_to_advanced",
      "_": "Build slot 1 (level 1) then immediately upgrade with key 5 (build_5). Player gold: 100 - 50 build - ... wait, only 50 left, can't upgrade (cost 100). Set gold higher in setup.",
      "setup": {
        "entity_state": {"player": {"gold": 200}}
      },
      "actions": [
        {"tick": 1, "input": "build_1"},
        {"tick": 2, "input": "build_5"}
      ],
      "ticks": 4,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.slot_1_level", "op": "==", "value": 2},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 50},
        {"type": "entity_count", "query": {"tags_all": ["tower_advanced"]},
         "op": "==", "value": 1}
      ]
    },

    {
      "name": "upgrade_blocked_when_no_tower",
      "_": "Pressing build_5 with no tower at slot 1 (slot_1_level == 0) should fail — query slot_1_level_eq 1 doesn't match.",
      "setup": {
        "entity_state": {"player": {"gold": 200}}
      },
      "actions": [
        {"tick": 1, "input": "build_5"}
      ],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.slot_1_level", "op": "==", "value": 0},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 200}
      ]
    },

    {
      "name": "upgrade_blocked_when_already_advanced",
      "_": "Build then upgrade twice — second upgrade should not fire (slot already at level 2).",
      "setup": {
        "entity_state": {"player": {"gold": 500}}
      },
      "actions": [
        {"tick": 1, "input": "build_1"},
        {"tick": 2, "input": "build_5"},
        {"tick": 3, "input": "build_5"}
      ],
      "ticks": 5,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": "==", "value": 350},
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.slot_1_level", "op": "==", "value": 2}
      ]
    },

    {
      "name": "first_wave_starts",
      "_": "After 4s (40 ticks @ 0.1s tick), wave_clock should have enemies_to_spawn > 0 (set by wave_start rule when wave_timer ≤ 0). Initial wave_timer = 3.0.",
      "setup": {},
      "actions": [],
      "ticks": 40,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["enemy"]},
         "op": ">=", "value": 1}
      ]
    },

    {
      "name": "enemy_advances_at_waypoint",
      "_": "Place enemy near wp_2 with eastward velocity. After contact (radius 0.8), velocity_set should swap to wp_2's stored next_v (0, 0, 2 — turn south). wp_2 is at (-3, 0, -7).",
      "setup": {
        "spawn": [
          {"def": "enemy_grunt", "id": "test_enemy",
           "position": [-3.5, 0, -7],
           "state": {"velocity": [2.0, 0, 0]}}
        ]
      },
      "actions": [],
      "ticks": 12,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "test_enemy",
         "field": "state.velocity.z", "op": ">", "value": 1.0}
      ]
    },

    {
      "name": "tower_fires_when_enemy_in_range",
      "_": "Manually spawn a tower at (-6, 0, -4) and an enemy 3m away. After 5 ticks, tower has fired and enemy took at least 1 damage. Towers are no longer pre-placed (player builds them now).",
      "setup": {
        "spawn": [
          {"def": "tower_basic", "id": "test_tower",
           "position": [-6, 0, -4],
           "state": {"cooldown": -1.0}},
          {"def": "enemy_grunt", "id": "rogue_enemy",
           "position": [-6, 0, -1],
           "state": {"velocity": [0, 0, 0], "hp": 99}}
        ]
      },
      "actions": [],
      "ticks": 5,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "rogue_enemy",
         "field": "state.hp", "op": "<", "value": 99},
        {"type": "entity_field", "select": "by_id", "id": "test_tower",
         "field": "state.cooldown", "op": ">", "value": 0.0}
      ]
    },

    {
      "name": "enemy_takes_damage_from_projectile",
      "_": "Place a projectile right next to an enemy (radius 0.6). After 2 ticks, projectile gone, enemy.hp reduced. No towers pre-placed in v1.5, so no contamination.",
      "setup": {
        "spawn": [
          {"def": "enemy_grunt", "id": "victim",
           "position": [0, 0, 0], "state": {"velocity": [0, 0, 0]}},
          {"def": "projectile", "id": "incoming_bolt",
           "position": [0.3, 0.6, 0], "state": {"velocity": [0, 0, 0]}}
        ]
      },
      "actions": [],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "victim",
         "field": "state.hp", "op": "<", "value": 3},
        {"type": "entity_count", "query": {"tags_all": ["projectile"]},
         "op": "==", "value": 0}
      ]
    },

    {
      "name": "enemy_at_base_damages_it",
      "_": "Place enemy 0.3m from base at (9, 0, 0). Contact (radius 0.8) should fire: -1 base.hp, enemy removed.",
      "setup": {
        "spawn": [
          {"def": "enemy_grunt", "id": "leaker",
           "position": [8.7, 0, 0], "state": {"velocity": [0, 0, 0]}}
        ]
      },
      "actions": [],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "base_1",
         "field": "state.hp", "op": "<", "value": 10},
        {"type": "entity_count", "query": {"tags_all": ["enemy"]},
         "op": "==", "value": 0}
      ]
    },

    {
      "name": "enemy_death_grants_gold",
      "_": "Manually zero an enemy's HP. enemy_death rule should fire (tick interval 1) → +5 gold, remove enemy.",
      "setup": {
        "spawn": [
          {"def": "enemy_grunt", "id": "dying_enemy",
           "position": [0, 0, 0], "state": {"hp": 0, "velocity": [0, 0, 0]}}
        ]
      },
      "actions": [],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "player",
         "field": "state.gold", "op": ">=", "value": 105},
        {"type": "entity_count", "query": {"tags_all": ["enemy"]},
         "op": "==", "value": 0}
      ]
    }
  ]
}

{
  "_comment": "Initial placements. Path is a zigzag fitting the 18m vertical view. Each waypoint stores velocity to set on enemies that touch it (direction to next waypoint, magnitude = enemy speed). Final waypoint is the base. path_dot decor entities visualize the path between waypoints (line patterns, ~7 dots per segment).",

  "patterns": [
    {"_": "Path visualization — 7 dots evenly spaced between each waypoint pair so the player can see where enemies walk.",
     "def": "path_dot", "id_prefix": "pd_a",
     "pattern": "line", "count": 7,
     "start": [-9, 0.02, -7], "end": [-3, 0.02, -7]},
    {"def": "path_dot", "id_prefix": "pd_b",
     "pattern": "line", "count": 7,
     "start": [-3, 0.02, -7], "end": [-3, 0.02, 0]},
    {"def": "path_dot", "id_prefix": "pd_c",
     "pattern": "line", "count": 7,
     "start": [-3, 0.02, 0], "end": [3, 0.02, 0]},
    {"def": "path_dot", "id_prefix": "pd_d",
     "pattern": "line", "count": 7,
     "start": [3, 0.02, 0], "end": [3, 0.02, 7]},
    {"def": "path_dot", "id_prefix": "pd_e",
     "pattern": "line", "count": 7,
     "start": [3, 0.02, 7], "end": [9, 0.02, 7]},
    {"def": "path_dot", "id_prefix": "pd_f",
     "pattern": "line", "count": 7,
     "start": [9, 0.02, 7], "end": [9, 0.02, 0]}
  ],

  "initial_instances": [
    {"def": "wave_clock", "id": "clock_1", "position": [0, 0, 0]},
    {"def": "player",     "id": "player",  "position": [0, 0, 0]},

    {"_": "Path waypoints — tightened to z range ±7 to fit comfortably in ortho_size=10 view (vertical=20m). Each next_vx/next_vz is unit-vector × 2 m/s (enemy speed) pointing to the next waypoint.",

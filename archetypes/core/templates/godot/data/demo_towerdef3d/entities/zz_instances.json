     "state": {"next_vx": 2.0, "next_vz": 0.0}},
    {"def": "waypoint", "id": "wp_2", "position": [-3, 0, -7],
     "state": {"next_vx": 0.0, "next_vz": 2.0}},
    {"def": "waypoint", "id": "wp_3", "position": [-3, 0, 0],
     "state": {"next_vx": 2.0, "next_vz": 0.0}},
    {"def": "waypoint", "id": "wp_4", "position": [3, 0, 0],
     "state": {"next_vx": 0.0, "next_vz": 2.0}},
    {"def": "waypoint", "id": "wp_5", "position": [3, 0, 7],
     "state": {"next_vx": 2.0, "next_vz": 0.0}},
    {"def": "waypoint", "id": "wp_6", "position": [9, 0, 7],
     "state": {"next_vx": 0.0, "next_vz": -2.0}},

    {"_": "The base — last node on the path. Enemies that contact it deal 1 damage and despawn.",
     "def": "base", "id": "base_1", "position": [9, 0, 0]},

    {"_": "Towers — placed along the path bends for coverage.",
     "def": "tower_basic", "id": "tower_a", "position": [-6, 0, -4]},

{
  "_comment": "Sokoban shell — title / game / pause flow. ADR 0011 reference: title screen → click 'New Game' to enter the world; ESC pauses; resume returns to gameplay.",

  "starting_screen": "title",

  "screens": [
    {
      "id": "title",
      "freeze_world": true,
      "background_color": "#2a2418",
      "background_alpha": 1.0,
      "elements": [
        {"type": "label", "text": "@strings.menu.title",
         "anchor": "top_center", "y_offset": 80,
         "font_size": 56, "color": "#dab048", "halign": "center"},
        {"type": "label", "text": "@strings.menu.subtitle",
         "anchor": "top_center", "y_offset": 150,
         "font_size": 24, "color": "#a07040", "halign": "center"},
        {"type": "vbox",
         "anchor": "center", "y_offset": -40, "separation": 12,
         "children": [
           {"type": "button", "text": "@strings.menu.new_game",
            "width": 240, "height": 48, "font_size": 22,
            "on_click": [
              {"type": "transition_screen", "target": "game"}
            ]},
           {"type": "button", "text": "@strings.menu.quit",
            "width": 240, "height": 48, "font_size": 22,
            "on_click": [{"type": "quit_app"}]}
         ]}
      ]
    },

    {
      "id": "game",
      "freeze_world": false,
      "elements": []
    },

    {
      "id": "pause",
      "modal": true,
      "freeze_world": true,
      "background_color": "#000000",
      "background_alpha": 0.65,
      "elements": [
        {"type": "label", "text": "@strings.menu.paused",
         "anchor": "top_center", "y_offset": 100,
         "font_size": 40, "color": "#dab048", "halign": "center"},
        {"type": "vbox",
         "anchor": "center", "separation": 12,
         "children": [
           {"type": "button", "text": "@strings.menu.resume",
            "width": 240, "height": 48, "font_size": 22,
            "on_click": [
              {"type": "transition_screen", "target": "game"}
            ]},
           {"type": "button", "text": "@strings.menu.main_menu",
            "width": 240, "height": 48, "font_size": 22,
            "on_click": [
              {"type": "load_data"}
            ]}
         ]}
      ]
    }
  ],

  "global_inputs": [
    {"action": "ui_cancel", "if_screen": "game",
     "on_press": [{"type": "transition_screen", "target": "pause"}]},
    {"action": "ui_cancel", "if_screen": "pause",
     "on_press": [{"type": "transition_screen", "target": "game"}]}
  ]
}

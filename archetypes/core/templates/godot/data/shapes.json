{
  "_comment": "Initial shape library — composes engine draw primitives (circle, rect, polygon, line) into recognizable visuals. Adding a new shape is a JSON edit. Each shape has default $params overridable via entity.visual.params.",

  "shapes": {
    "tile_32": {
      "_comment": "Filled 32×32 square, centered. Useful for grid-cell content at 32px resolution (sokoban walls etc).",
      "primitives": [
        {"op": "rect", "pos": [-16, -16], "size": [32, 32], "color": "$color"}
      ],
      "params": {"color": "#888888"}
    },

    "tile_26": {
      "_comment": "Filled 26×26 square, centered. Slightly inset from a 32-cell — for crates/movables that visually fit inside a tile with margin.",
      "primitives": [
        {"op": "rect", "pos": [-13, -13], "size": [26, 26], "color": "$color"}
      ],
      "params": {"color": "#888888"}
    },

    "filled_circle": {
      "_comment": "Filled circle with per-entity radius/color via params. Default 12px.",
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": "$radius", "color": "$color"}
      ],
      "params": {"radius": 12, "color": "#888888"}
    },

    "tree": {
      "primitives": [
        {"op": "rect",   "pos": [-3, -2],  "size": [6, 16], "color": "$trunk"},
        {"op": "circle", "pos": [0, -10],  "radius": 12,    "color": "$foliage"}
      ],
      "params": {"foliage": "#3a8a3a", "trunk": "#6b3a1a"}
    },

    "rock": {
      "primitives": [
        {"op": "polygon",
         "points": [[-8, 4], [-6, -6], [2, -8], [9, -3], [7, 6]],
         "color": "$stone"}
      ],
      "params": {"stone": "#7a7a7a"}
    },

    "person": {
      "primitives": [
        {"op": "circle", "pos": [0, -10], "radius": 5, "color": "$skin"},
        {"op": "rect",   "pos": [-4, -4], "size": [8, 12], "color": "$shirt"}
      ],
      "params": {"skin": "#e0b094", "shirt": "#5b9bff"}
    },

    "water": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": "$radius", "color": "$water_dark"},
        {"op": "circle", "pos": [-3, -3], "radius": 3, "color": "$water_glint"}
      ],
      "params": {"radius": 16, "water_dark": "#3b7fb8", "water_glint": "#9ad0f0"}
    },

    "fire": {
      "primitives": [
        {"op": "circle", "pos": [0, 2],  "radius": 8, "color": "$flame_outer"},
        {"op": "circle", "pos": [0, -1], "radius": 5, "color": "$flame_inner"},
        {"op": "circle", "pos": [0, -4], "radius": 2, "color": "$flame_core"}
      ],
      "params": {"flame_outer": "#d94c1a", "flame_inner": "#f4a233", "flame_core": "#ffe066"}
    },

    "building": {
      "primitives": [
        {"op": "rect",    "pos": [-12, -4], "size": [24, 16], "color": "$wall"},
        {"op": "polygon",
         "points": [[-14, -4], [0, -16], [14, -4]],
         "color": "$roof"},
        {"op": "rect",    "pos": [-3, 4],   "size": [6, 8], "color": "$door"}
      ],
      "params": {"wall": "#b8a98a", "roof": "#7a3a2a", "door": "#3a2818"}
    },

    "weapon": {
      "primitives": [
        {"op": "rect", "pos": [-1, -8], "size": [2, 12], "color": "$blade"},
        {"op": "rect", "pos": [-4, 4],  "size": [8, 2],  "color": "$guard"},
        {"op": "rect", "pos": [-1, 6],  "size": [2, 4],  "color": "$grip"}
      ],
      "params": {"blade": "#c0c0c0", "guard": "#5c4a2a", "grip": "#3a2818"}
    },

    "food": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 6, "color": "$body"},
        {"op": "circle", "pos": [-2, -2], "radius": 1.5, "color": "$highlight"}
      ],
      "params": {"body": "#d4b54a", "highlight": "#fff7d6"}
    },

    "crop_seed": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 3, "color": "$seed"}
      ],
      "params": {"seed": "#8b5a2b"}
    },

    "crop_young": {
      "primitives": [
        {"op": "rect",   "pos": [-1, 0],  "size": [2, 8], "color": "$stem"},
        {"op": "circle", "pos": [0, -2],  "radius": 4,    "color": "$leaf"}
      ],
      "params": {"stem": "#5a8a3a", "leaf": "#7eb86b"}
    },

    "crop_mature": {
      "primitives": [
        {"op": "rect",   "pos": [-1, 0],   "size": [2, 12], "color": "$stem"},
        {"op": "circle", "pos": [-3, -6],  "radius": 4,     "color": "$grain"},
        {"op": "circle", "pos": [3, -6],   "radius": 4,     "color": "$grain"},
        {"op": "circle", "pos": [0, -10],  "radius": 4,     "color": "$grain"}
      ],
      "params": {"stem": "#5a8a3a", "grain": "#d4b54a"}
    },

    "crop_rotten": {
      "primitives": [
        {"op": "rect",   "pos": [-1, 0],  "size": [2, 6], "color": "$rot"},
        {"op": "circle", "pos": [0, -1],  "radius": 3,    "color": "$rot_top"}
      ],
      "params": {"rot": "#3a2818", "rot_top": "#5a3a28"}
    },

    "sparkle": {
      "primitives": [
        {"op": "polygon",
         "points": [[0, -6], [2, -2], [6, 0], [2, 2], [0, 6], [-2, 2], [-6, 0], [-2, -2]],
         "color": "$glow"}
      ],
      "params": {"glow": "#ffd34a"}
    },

    "marker": {
      "primitives": [
        {"op": "rect", "pos": [-3, -3], "size": [6, 6], "color": "$mark"}
      ],
      "params": {"mark": "#aaaaaa"}
    },

    "square": {
      "primitives": [
        {"op": "rect", "pos": "$origin", "size": "$size", "color": "$color"}
      ],
      "params": {"origin": [-5, -5], "size": [10, 10], "color": "#888"}
    },

    "triangle": {
      "primitives": [
        {"op": "polygon",
         "points": [[0, -8], [7, 5], [-7, 5]],
         "color": "$color"}
      ],
      "params": {"color": "#888"}
    },

    "invisible_marker": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 1, "color": "$color"}
      ],
      "params": {"color": "#00000000"}
    },

    "tinypond_pond_water": {
      "_comment": "Lily pad — round flat disc, pink lotus flower in center.",
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 24, "color": "$pad_dark"},
        {"op": "circle", "pos": [0, 0], "radius": 19, "color": "$pad"},
        {"op": "circle", "pos": [0, 0], "radius": 6, "color": "$flower"},
        {"op": "circle", "pos": [0, 0], "radius": 3, "color": "$flower_core"}
      ],
      "params": {"pad_dark": "#1f4538", "pad": "#3d7a5e", "flower": "#f5b8d4", "flower_core": "#fff4cc"}
    },

    "tinypond_sun": {
      "_comment": "Bright sun above the pond — drawn as glowing yellow disc.",
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 32, "color": "$glow_outer"},
        {"op": "circle", "pos": [0, 0], "radius": 24, "color": "$glow"},
        {"op": "circle", "pos": [0, 0], "radius": 18, "color": "$core"}
      ],
      "params": {"glow_outer": "#ffe89a", "glow": "#ffd470", "core": "#fff8a0"}
    },

    "tinypond_plant_seed": {
      "_comment": "Small water sprout — tiny green tendril just emerging.",
      "primitives": [
        {"op": "rect",   "pos": [-2, 0],  "size": [4, 6], "color": "$base"},
        {"op": "rect",   "pos": [-1, -8], "size": [2, 10], "color": "$stem"},
        {"op": "circle", "pos": [-3, -10], "radius": 4, "color": "$leaf"},
        {"op": "circle", "pos": [ 3, -10], "radius": 4, "color": "$leaf"}
      ],
      "params": {"base": "#2c5a3a", "stem": "#3d7a4d", "leaf": "#6db86d"}
    },

    "tinypond_plant_mature": {
      "_comment": "Mature water plant — kelp/seaweed shape with multiple flowing fronds. No flower (this is underwater). Greens shifted toward blue-teal for aquatic feel.",
      "primitives": [
        {"op": "circle", "pos": [0, 12],  "radius": 9, "color": "$base"},
        {"op": "rect",   "pos": [-2, -12], "size": [4, 24], "color": "$stem"},
        {"op": "polygon", "points": [[-3, -10], [-15, -22], [-10, -8]],  "color": "$frond"},
        {"op": "polygon", "points": [[3, -10], [15, -22], [10, -8]],     "color": "$frond"},
        {"op": "polygon", "points": [[-3, 0], [-18, -8], [-12, 4]],      "color": "$frond_d"},
        {"op": "polygon", "points": [[3, 0], [18, -8], [12, 4]],         "color": "$frond_d"},
        {"op": "polygon", "points": [[-2, -16], [-2, -28], [3, -16]],    "color": "$tip"},
        {"op": "polygon", "points": [[2, -16], [8, -30], [3, -16]],      "color": "$tip"}
      ],
      "params": {"base": "#1a3826", "stem": "#2c5a3a", "frond": "#3d7a4d", "frond_d": "#2c5a3a", "tip": "#6db86d"}
    },

    "tinypond_fish": {
      "primitives": [
        {"op": "circle", "pos": [-2, 0], "radius": 14, "color": "$body"},
        {"op": "rect",   "pos": [-22, -5], "size": [12, 10], "color": "$tail"},
        {"op": "circle", "pos": [6, -3], "radius": 3, "color": "$eyewhite"},
        {"op": "circle", "pos": [7, -3], "radius": 1.5, "color": "$pupil"}
      ],
      "params": {"body": "#e88030", "tail": "#c06010", "eyewhite": "#ffffff", "pupil": "#000000"}
    },

    "doomarena_marine": {
      "_comment": "Marine — cyan armored figure. Body circle + helmet/visor + small gun jutting forward (drawn as art-faces-right by convention).",
      "primitives": [
        {"op": "circle", "pos": [0, 0],  "radius": 14, "color": "$body"},
        {"op": "circle", "pos": [0, -2], "radius": 8,  "color": "$armor"},
        {"op": "rect",   "pos": [4, -3], "size": [12, 4], "color": "$armor"},
        {"op": "circle", "pos": [3, -2], "radius": 3,  "color": "$visor"}
      ],
      "params": {"body": "#3aa8e8", "armor": "#2080c0", "visor": "#80e0ff"}
    },

    "doomarena_imp": {
      "_comment": "Imp — small dark-red roundish blob with two yellow eye dots.",
      "primitives": [
        {"op": "circle", "pos": [0, 0],   "radius": 12, "color": "$body"},
        {"op": "circle", "pos": [-3, -2], "radius": 1.8, "color": "$eye"},
        {"op": "circle", "pos": [3, -2],  "radius": 1.8, "color": "$eye"}
      ],
      "params": {"body": "#a02020", "eye": "#ffd040"}
    },

    "doomarena_demon": {
      "_comment": "Demon — bigger dark-purple angular shape with red eyes. Tougher silhouette.",
      "primitives": [
        {"op": "polygon",
         "points": [[-14, -8], [14, -8], [16, 6], [0, 14], [-16, 6]],
         "color": "$body"},
        {"op": "circle", "pos": [-5, -3], "radius": 2.5, "color": "$eye"},
        {"op": "circle", "pos": [5, -3],  "radius": 2.5, "color": "$eye"},
        {"op": "rect",   "pos": [-10, -10], "size": [20, 3], "color": "$highlight"}
      ],
      "params": {"body": "#5a1c4a", "highlight": "#9a2c8a", "eye": "#ff4040"}
    },

    "doomarena_bullet": {
      "_comment": "Plasma bolt — bright yellow streak. Drawn pointing right (+x); rotate_with_velocity points it in fire direction.",
      "primitives": [
        {"op": "rect",   "pos": [-10, -2], "size": [10, 4], "color": "$tail"},
        {"op": "circle", "pos": [0, 0],    "radius": 4,     "color": "$core"}
      ],
      "params": {"core": "#ffe060", "tail": "#ff8020"}
    },

    "doomarena_health_pickup": {
      "primitives": [
        {"op": "rect",   "pos": [-10, -10], "size": [20, 20], "color": "$box"},
        {"op": "rect",   "pos": [-2, -8],   "size": [4, 16], "color": "$cross"},
        {"op": "rect",   "pos": [-8, -2],   "size": [16, 4], "color": "$cross"}
      ],
      "params": {"box": "#f0f0f0", "cross": "#d02040"}
    },

    "doomarena_ammo_pickup": {
      "primitives": [
        {"op": "rect", "pos": [-10, -8], "size": [20, 16], "color": "$box"},
        {"op": "rect", "pos": [-10, -2], "size": [20, 4],  "color": "$stripe"}
      ],
      "params": {"box": "#e0c040", "stripe": "#806020"}
    },

    "doomarena_spark": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 5, "color": "$glow"},
        {"op": "circle", "pos": [0, 0], "radius": 2.5, "color": "$core"}
      ],
      "params": {"glow": "#ffe080", "core": "#ffffff"}
    },

    "doomarena_wall": {
      "primitives": [
        {"op": "rect", "pos": [-12, -6], "size": [24, 12], "color": "$core"},
        {"op": "rect", "pos": [-12, -6], "size": [24, 2],  "color": "$highlight"}
      ],
      "params": {"core": "#a02020", "highlight": "#e04040"}
    }
  }
}

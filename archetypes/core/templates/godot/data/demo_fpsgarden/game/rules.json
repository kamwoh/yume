{
  "_comment": "FPSGarden GAME rules (ADR 0009 Phase 3b). Score-on-orb-collect.",
  "rules": [
    {
      "_comment": "=== ORB COLLECTION ===",
      "id": "collect_orb",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "player"
          ]
        },
        "b": {
          "tags_all": [
            "orb"
          ]
        },
        "radius": 1.2
      },
      "effect": [
        {
          "type": "state_add",
          "target": "a",
          "field": "score",
          "amount": 1
        },
        {
          "type": "remove",
          "target": "b"
        },
        {
          "type": "emit_shell_event",
          "event": "shake",
          "intensity": 0.05,
          "duration": 6
        }
      ]
    }
  ]
}
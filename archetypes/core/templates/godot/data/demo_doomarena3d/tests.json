    {
      "name": "weapon_cooldown_blocks_immediate_refire",
      "_": "v2.5: shotgun cooldown=8 ticks. Fire at tick 1, fire again at tick 2 — second fire blocked because cooldown=8.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 30, "current_weapon": 2, "weapon_cooldown": 0, "position": [0, 0, 0]},

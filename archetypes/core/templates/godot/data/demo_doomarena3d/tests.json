{
  "_comment": "Game-specific scenario tests for doomarena3d. Tier 2.6s. Each scenario builds a fresh World, applies setup, ticks forward, injects scripted inputs, then asserts. The first test (bullet_moves_after_fire) is the regression for the spawn-override-formula bug found 2026-05-03.",

  "scenarios": [
    {
      "name": "bullet_spawns_on_fire",
      "_": "Pressing SPACE (spark) on tick 1 should spawn exactly 1 bullet.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 3,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": "==", "value": 1}
      ]
    },

    {
      "name": "bullet_moves_after_fire",
      "_": "REGRESSION: bullet velocity must be Vector3, not Vector3.ZERO. Camera convention: at facing=0, pitch=0, forward = -Z. Bullet velocity formula = (-sin(f)*cos(p), -sin(p), -cos(f)*cos(p)) * 22. At facing=pitch=0, that's (0, 0, -22). After 8 ticks at tick_seconds=0.05, bullet should be at z ≈ -0.6 (spawn) - 22*0.05*8 = -9.4.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 8,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": ">=", "value": 1},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["bullet"]},
         "field": "state.position.z", "op": "<", "value": -1.0}
      ]
    },

    {
      "name": "ammo_decrements_on_fire",
      "_": "Each fire reduces ammo by 1. Start at 5, fire 3 times → 2.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"},
        {"tick": 2, "input": "spark"},
        {"tick": 3, "input": "spark"}
      ],
      "ticks": 4,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.ammo", "op": "==", "value": 2}
      ]
    },

    {
      "name": "bullet_flies_up_when_aiming_up",
      "_": "REGRESSION: positive pitch = looking up. Bullet Y component must be +sin(pitch)*22, not -sin(pitch)*22. At pitch=0.5 (≈29° up), bullet should rise: y(t) = 1.6 + sin(0.5)*0.6 (spawn) + sin(0.5)*22*delta*ticks. After 8 ticks at 0.05s: y ≈ 1.89 + 0.479*22*0.4 ≈ 1.89 + 4.22 ≈ 6.1 m. Permissive bound y > 3.0.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0.5, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 8,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["bullet"]},
         "field": "state.position.y", "op": ">", "value": 3.0}
      ]
    },

    {
      "name": "five_imps_all_home",
      "_": "5 imps from different angles. Spawn rules disabled. After 50 ticks (2.5s), each imp should have moved at least 5m closer to origin (started 10m away, speed 3.5 m/s → 8.75m closer in 2.5s, but we test less).",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]},
          "clock_1": {"spawn_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_imp", "id": "imp_a", "position": [10, 0, 0]},
          {"def": "monster_imp", "id": "imp_b", "position": [-10, 0, 0]},
          {"def": "monster_imp", "id": "imp_c", "position": [0, 0, 10]},
          {"def": "monster_imp", "id": "imp_d", "position": [0, 0, -10]},
          {"def": "monster_imp", "id": "imp_e", "position": [7, 0, 7]}
        ]
      },
      "actions": [],
      "ticks": 50,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "imp_a",
         "field": "state.position.x", "op": "<", "value": 8},
        {"type": "entity_field", "select": "by_id", "id": "imp_b",
         "field": "state.position.x", "op": ">", "value": -8},
        {"type": "entity_field", "select": "by_id", "id": "imp_c",
         "field": "state.position.z", "op": "<", "value": 8},
        {"type": "entity_field", "select": "by_id", "id": "imp_d",
         "field": "state.position.z", "op": ">", "value": -8},
        {"type": "entity_field", "select": "by_id", "id": "imp_e",
         "field": "state.position.x", "op": "<", "value": 6}
      ]
    },

    {
      "name": "single_monster_long_run",
      "_": "ONE imp, 200 ticks. No spawn rule pressure. Should walk to player and trigger contact removal.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]},
          "clock_1": {"spawn_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_imp", "id": "lone_imp", "position": [10, 0, 5]}
        ]
      },
      "actions": [],
      "ticks": 200,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": "==", "value": 0},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "monster_long_run_reaches_player",
      "_": "Like live smoke (1200 ticks). Imp at typical spawn (10, 0, 5). Should reach player and trigger contact eventually. After 1200 ticks (60s simulated), monster count is bounded (v2: demons + rangers spawn after 30s, so cap is more permissive than v1) AND player.hp should be < 100.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]}
        },
        "spawn": [
          {"def": "monster_imp", "id": "test_imp_long", "position": [10, 0, 5]}
        ]
      },
      "actions": [],
      "ticks": 1200,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": "<=", "value": 12},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "monster_reaches_and_kills_player",
      "_": "Run long enough for an imp to walk from x=8 to player at origin (8m / 3.5 m/s = ~2.3s = 46 ticks). After 80 ticks (4s), imp should have hit player → imp removed (monster_hits_player), player HP -10.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]}
        },
        "spawn": [
          {"def": "monster_imp", "id": "test_imp", "position": [8, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 80,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": "==", "value": 0},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "monster_homes_toward_player",
      "_": "User playtest: 'the bot didn't come to me?' Spawn imp at x=10, player at origin. After 10 ticks (0.5s) imp should move toward player (lower x). Imp speed=3.5 m/s × 0.5s = 1.75 m closer, so x should drop from 10 to ~8.25. Permissive bound x < 9.5.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]}
        },
        "spawn": [
          {"def": "monster_imp", "id": "test_imp", "position": [10, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 10,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": "==", "value": 1},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["monster"]},
         "field": "state.position.x", "op": "<", "value": 9.5}
      ]
    },

    {
      "name": "fire_blocked_when_no_ammo",
      "_": "ammo=0 → fire rule's `state.ammo_gt: 0` query fails → no bullet.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 0, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 3,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": "==", "value": 0}
      ]
    },

    {
      "name": "ranger_fire_damages_player",
      "_": "v2: spawn a ranger at distance 5 (within fire_range=6). After 80 ticks ranger fires multiple times; bullets travel 8 m/s → reach player; player.hp drops below 100. Tests the full ranger AI loop: cooldown decrement → fire → bullet flies → damage.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "hp": 100},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_ranger", "id": "test_ranger", "position": [5, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 80,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "ranger_holds_position_when_in_range",
      "_": "v2: ranger AI plants when distance ≤ fire_range. Spawn at distance 5; after 30 ticks ranger should not have crossed into 'kamikaze' territory (still ≥ 4m from player).",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_ranger", "id": "stand_ranger", "position": [5, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 30,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "stand_ranger",
         "field": "state.position.x", "op": ">", "value": 4.0}
      ]
    },

    {
      "name": "enemy_bullet_damages_player",
      "_": "v2: spawn enemy_bullet on top of player. Contact rule fires → -10 HP. After 3 ticks (one contact pass), player.hp should be ≤ 90.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "hp": 100},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "enemy_bullet", "id": "test_eb", "position": [0.5, 0.5, 0]}
        ]
      },
      "actions": [],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<=", "value": 90}
      ]
    },

    {
      "name": "boss_spawns_when_score_reaches_25",
      "_": "v2 signature moment: set player.score = 25, leave clock.boss_spawned = 0. boss_spawn_check fires on first contact tick → 1 boss exists, clock.boss_spawned latches to 1.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "score": 25},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0, "boss_spawned": 0}
        }
      },
      "actions": [],
      "ticks": 5,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["boss"]},
         "op": "==", "value": 1},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["clock"]},
         "field": "state.boss_spawned", "op": "==", "value": 1}
      ]
    },

    {
      "name": "boss_does_not_spawn_below_score_25",
      "_": "v2: at score 24, no boss should spawn even after many ticks.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "score": 24},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0, "boss_spawned": 0}
        }
      },
      "actions": [],
      "ticks": 20,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["boss"]},
         "op": "==", "value": 0}
      ]
    },

    {
      "name": "wall_blocks_player",
      "_": "ADR 0004: walking west into the west wall (at x=-22, blocks_motion + aabb_extents [0.25, 1.5, 22]) should stop the player. After holding W with facing rotated to face -X for 60 ticks (3s), player.x should not pass the wall plane minus body radius (~-21.6, but we check >-22 strict).",
      "setup": {
        "entity_state": {
          "player": {"facing": -1.5708, "pitch": 0, "ammo": 0, "position": [-15, 0, 0]},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        }
      },
      "actions": [
        {"tick": 1, "input": "move_north"}, {"tick": 2, "input": "move_north"},
        {"tick": 3, "input": "move_north"}, {"tick": 4, "input": "move_north"},
        {"tick": 5, "input": "move_north"}, {"tick": 6, "input": "move_north"},
        {"tick": 7, "input": "move_north"}, {"tick": 8, "input": "move_north"},
        {"tick": 9, "input": "move_north"}, {"tick": 10, "input": "move_north"},
        {"tick": 15, "input": "move_north"}, {"tick": 20, "input": "move_north"},
        {"tick": 25, "input": "move_north"}, {"tick": 30, "input": "move_north"},
        {"tick": 40, "input": "move_north"}, {"tick": 50, "input": "move_north"},
        {"tick": 60, "input": "move_north"}
      ],
      "ticks": 60,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.position.x", "op": ">", "value": -22.0}
      ]
    },

    {
      "name": "diagonal_movement_works",
      "_": "v2.5: pressing W + A in the same tick should produce diagonal motion. velocity_set_relative would lose one axis (last write wins); velocity_add_relative accumulates. After 30 ticks of holding W+A from origin facing=0 (forward = -Z, strafe-left = -X), player should have moved in BOTH -X (left) AND -Z (forward) by at least 1m each.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 0, "position": [0, 0, 0]},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        }
      },
      "actions": [
        {"tick": 1, "input": "move_north"}, {"tick": 1, "input": "move_west"},
        {"tick": 2, "input": "move_north"}, {"tick": 2, "input": "move_west"},
        {"tick": 3, "input": "move_north"}, {"tick": 3, "input": "move_west"},
        {"tick": 4, "input": "move_north"}, {"tick": 4, "input": "move_west"},
        {"tick": 5, "input": "move_north"}, {"tick": 5, "input": "move_west"},
        {"tick": 6, "input": "move_north"}, {"tick": 6, "input": "move_west"},
        {"tick": 7, "input": "move_north"}, {"tick": 7, "input": "move_west"},
        {"tick": 8, "input": "move_north"}, {"tick": 8, "input": "move_west"},
        {"tick": 9, "input": "move_north"}, {"tick": 9, "input": "move_west"},
        {"tick": 10, "input": "move_north"}, {"tick": 10, "input": "move_west"},
        {"tick": 11, "input": "move_north"}, {"tick": 11, "input": "move_west"},
        {"tick": 12, "input": "move_north"}, {"tick": 12, "input": "move_west"},
        {"tick": 13, "input": "move_north"}, {"tick": 13, "input": "move_west"},
        {"tick": 14, "input": "move_north"}, {"tick": 14, "input": "move_west"},
        {"tick": 15, "input": "move_north"}, {"tick": 15, "input": "move_west"},
        {"tick": 16, "input": "move_north"}, {"tick": 16, "input": "move_west"},
        {"tick": 17, "input": "move_north"}, {"tick": 17, "input": "move_west"},
        {"tick": 18, "input": "move_north"}, {"tick": 18, "input": "move_west"},
        {"tick": 19, "input": "move_north"}, {"tick": 19, "input": "move_west"},
        {"tick": 20, "input": "move_north"}, {"tick": 20, "input": "move_west"},
        {"tick": 21, "input": "move_north"}, {"tick": 21, "input": "move_west"},
        {"tick": 22, "input": "move_north"}, {"tick": 22, "input": "move_west"},
        {"tick": 23, "input": "move_north"}, {"tick": 23, "input": "move_west"},
        {"tick": 24, "input": "move_north"}, {"tick": 24, "input": "move_west"},
        {"tick": 25, "input": "move_north"}, {"tick": 25, "input": "move_west"},
        {"tick": 26, "input": "move_north"}, {"tick": 26, "input": "move_west"},
        {"tick": 27, "input": "move_north"}, {"tick": 27, "input": "move_west"},
        {"tick": 28, "input": "move_north"}, {"tick": 28, "input": "move_west"},
        {"tick": 29, "input": "move_north"}, {"tick": 29, "input": "move_west"},
        {"tick": 30, "input": "move_north"}, {"tick": 30, "input": "move_west"}
      ],
      "ticks": 30,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.position.x", "op": "<", "value": -1.0},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.position.z", "op": "<", "value": -1.0}
      ]
    },

    {

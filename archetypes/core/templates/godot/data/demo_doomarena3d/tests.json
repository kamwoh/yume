      ]
    },

    {
      "name": "boss_killed_sets_victory_flag",
      "_": "v2 signature win: spawn boss at low HP, hit it once → hp ≤ 0 → boss_killed_win sets clock.boss_killed=1 → HUD wins.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0, "boss_spawned": 1}

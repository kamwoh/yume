          "player": {"facing": 0, "pitch": 0, "ammo": 30, "current_weapon": 1, "position": [0, 0, 0]},
          "clock_1": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}

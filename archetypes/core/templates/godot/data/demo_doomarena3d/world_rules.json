{
  "_comment": "DoomArena3D rules — v2 (Tier 2.7). Categories: clock, input, AI, combat, pickups, bounds, plus v2 additions: ranger AI (stop+fire), enemy bullet, boss spawn at score≥25, boss-killed-win, wave phases, demon/ranger spawn after Mixed phase (≥30s), siren at Rush phase (≥60s).",

  "rules": [

    {
      "_comment": "=== CLOCK ===",
      "id": "clock_advance",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"]},
      "effect": [
        {"type": "state_add", "target": "self", "field": "elapsed", "amount": 0.05},
        {"type": "state_add", "target": "self", "field": "spawn_timer", "amount": -0.05},
        {"type": "state_add", "target": "self", "field": "demon_timer", "amount": -0.05},
        {"type": "state_add", "target": "self", "field": "ranger_timer", "amount": -0.05},
        {"type": "state_add", "target": "self", "field": "pickup_timer", "amount": -0.05}
      ]
    },

    {
      "_comment": "Spawn imp at random angle on the spawn ring (radius 18 — just inside the ±22m walls). Interval shortens with elapsed.",
      "id": "monster_spawn",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"], "state": {"spawn_timer_lt": 0.0}},
      "effect": [
        {"type": "spawn",
         "template": "monster_imp",
         "position": [
           "cos(randf() * 6.28318) * 18",
           0,
           "sin(randf() * 6.28318) * 18"
         ]},
        {"type": "state_set", "target": "self", "field": "spawn_timer",
         "value": "max(2.0, 4.0 - self.state.elapsed * 0.022)"}
      ]
    },

    {
      "_comment": "Mixed phase (elapsed ≥ 30s): demons start spawning every 8s.",
      "id": "monster_spawn_demon",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"], "state": {"demon_timer_lt": 0.0, "elapsed_gte": 30}},
      "effect": [
        {"type": "spawn",
         "template": "monster_demon",
         "position": [
           "cos(randf() * 6.28318) * 18",
           0,
           "sin(randf() * 6.28318) * 18"
         ]},
        {"type": "state_set", "target": "self", "field": "demon_timer", "value": 8.0}
      ]
    },

    {
      "_comment": "Mixed phase: rangers start spawning every 12s. Slower than demons because they're more dangerous (ranged + forces flanking).",
      "id": "monster_spawn_ranger",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"], "state": {"ranger_timer_lt": 0.0, "elapsed_gte": 30}},
      "effect": [
        {"type": "spawn",
         "template": "monster_ranger",
         "position": [
           "cos(randf() * 6.28318) * 18",
           0,
           "sin(randf() * 6.28318) * 18"
         ]},
        {"type": "state_set", "target": "self", "field": "ranger_timer", "value": 12.0}
      ]
    },

    {
      "_comment": "Health pickup spawn at random arena position. 50% chance per pickup-timer tick.",
      "id": "pickup_spawn_health",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"], "state": {"pickup_timer_lt": 0.0}},
      "chance": 0.5,
      "effect": [
        {"type": "spawn", "template": "health_pickup",
         "position": ["(randf() - 0.5) * 36", 0.5, "(randf() - 0.5) * 36"]},
        {"type": "state_set", "target": "self", "field": "pickup_timer", "value": 7.0}
      ]
    },

    {
      "_comment": "Ammo pickup — fires when health didn't (timer reset by either rule keeps cadence).",
      "id": "pickup_spawn_ammo",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["clock"], "state": {"pickup_timer_lt": 0.0}},
      "effect": [
        {"type": "spawn", "template": "ammo_pickup",
         "position": ["(randf() - 0.5) * 36", 0.5, "(randf() - 0.5) * 36"]},
        {"type": "state_set", "target": "self", "field": "pickup_timer", "value": 7.0}
      ]
    },

    {
      "_comment": "=== PLAYER MOVEMENT (velocity_add_relative — accumulates per-tick contributions so W+A diagonal works). Drag in player.state.drag handles deceleration. Per-tick add of 2.0 with drag=8 + tick=0.05s gives equilibrium speed ≈ 3.0 m/s (marine pace, slightly slower than imps at 3.5 — player can outrun rangers/demons but imps catch up).",
      "id": "move_forward",
      "trigger": {"type": "input", "action": "move_north"},
      "effect": {"type": "velocity_add_relative", "target": "actor", "forward": 2.0, "strafe": 0}
    },
    {
      "id": "move_back",
      "trigger": {"type": "input", "action": "move_south"},
      "effect": {"type": "velocity_add_relative", "target": "actor", "forward": -2.0, "strafe": 0}
    },
    {
      "id": "strafe_right",
      "trigger": {"type": "input", "action": "move_east"},
      "effect": {"type": "velocity_add_relative", "target": "actor", "forward": 0, "strafe": -2.0}
    },
    {
      "id": "strafe_left",
      "trigger": {"type": "input", "action": "move_west"},
      "effect": {"type": "velocity_add_relative", "target": "actor", "forward": 0, "strafe": 2.0}
    },

    {
      "_comment": "=== WEAPON SWITCH — PRESS-edge. Set current_weapon to 1/2/3. Doesn't reset cooldown (prevents weapon-switch exploit).",
      "id": "weapon_switch_1",
      "trigger": {"type": "input", "action": "weapon_1"},
      "query": {"tags_all": ["player"]},
      "effect": [
        {"type": "state_set", "target": "self", "field": "current_weapon", "value": 1},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"}
      ]
    },
    {
      "id": "weapon_switch_2",
      "trigger": {"type": "input", "action": "weapon_2"},
      "query": {"tags_all": ["player"]},
      "effect": [
        {"type": "state_set", "target": "self", "field": "current_weapon", "value": 2},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"}
      ]
    },
    {
      "id": "weapon_switch_3",
      "trigger": {"type": "input", "action": "weapon_3"},
      "query": {"tags_all": ["player"]},
      "effect": [
        {"type": "state_set", "target": "self", "field": "current_weapon", "value": 3},
        {"type": "emit_shell_event", "event": "play_sound", "name": "build"}
      ]
    },

    {
      "_comment": "=== WEAPON COOLDOWN tick. Decrements weapon_cooldown by 1 per tick (player-only). At cooldown ≤ 0 the next fire can proceed.",
      "id": "weapon_cooldown_tick",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["player"], "state": {"weapon_cooldown_gt": 0}},
      "effect": {"type": "state_add", "target": "self", "field": "weapon_cooldown", "amount": -1}
    },

    {
      "_comment": "=== FIRE PLASMA (current_weapon=1). PRESS-edge SPACE. Camera convention: rotation=Vector3(pitch, facing, 0) in YXZ order. Forward vector (-sin(f)*cos(p), +sin(p), -cos(f)*cos(p)). Bullet spawns at eye level (1.6m), velocity = forward × 22 m/s. Plasma has zero cooldown — the trigger is press-edge so each keystroke = 1 fire.",
      "id": "fire_plasma",
      "trigger": {"type": "input", "action": "spark"},
      "query": {"tags_all": ["player"], "state": {"ammo_gt": 0, "current_weapon": 1, "weapon_cooldown_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "bullet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing) * cos(self.state.pitch) * 22",
           "sin(self.state.pitch) * 22",
           "-cos(self.state.facing) * cos(self.state.pitch) * 22"
         ]}}},
        {"type": "state_add", "target": "self", "field": "ammo", "amount": -1},
        {"type": "emit_shell_event", "event": "play_sound", "name": "shoot"}
      ]
    },

    {
      "_comment": "=== FIRE SHOTGUN (current_weapon=2). 5 pellets in ±15° horizontal spread. Each pellet uses same forward formula but with angle offset. Cost: 3 ammo. Cooldown: 8 ticks (~0.4s).",
      "id": "fire_shotgun",
      "trigger": {"type": "input", "action": "spark"},
      "query": {"tags_all": ["player"], "state": {"ammo_gte": 3, "current_weapon": 2, "weapon_cooldown_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "bullet_pellet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing - 0.262) * cos(self.state.pitch) * 18",
           "sin(self.state.pitch) * 18",
           "-cos(self.state.facing - 0.262) * cos(self.state.pitch) * 18"
         ]}}},
        {"type": "spawn", "template": "bullet_pellet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing - 0.131) * cos(self.state.pitch) * 18",
           "sin(self.state.pitch) * 18",
           "-cos(self.state.facing - 0.131) * cos(self.state.pitch) * 18"
         ]}}},
        {"type": "spawn", "template": "bullet_pellet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing) * cos(self.state.pitch) * 18",
           "sin(self.state.pitch) * 18",
           "-cos(self.state.facing) * cos(self.state.pitch) * 18"
         ]}}},
        {"type": "spawn", "template": "bullet_pellet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing + 0.131) * cos(self.state.pitch) * 18",
           "sin(self.state.pitch) * 18",
           "-cos(self.state.facing + 0.131) * cos(self.state.pitch) * 18"
         ]}}},
        {"type": "spawn", "template": "bullet_pellet",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing + 0.262) * cos(self.state.pitch) * 18",
           "sin(self.state.pitch) * 18",
           "-cos(self.state.facing + 0.262) * cos(self.state.pitch) * 18"
         ]}}},
        {"type": "state_add", "target": "self", "field": "ammo", "amount": -3},
        {"type": "state_set", "target": "self", "field": "weapon_cooldown", "value": 8},
        {"type": "emit_shell_event", "event": "play_sound", "name": "shotgun_blast"}
      ]
    },

    {
      "_comment": "=== FIRE ROCKET (current_weapon=3). Single bigger bolt at 14 m/s with 3 damage. Cost: 5 ammo. Cooldown: 15 ticks (~0.75s). Heavy boss-killer.",
      "id": "fire_rocket",
      "trigger": {"type": "input", "action": "spark"},
      "query": {"tags_all": ["player"], "state": {"ammo_gte": 5, "current_weapon": 3, "weapon_cooldown_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "bullet_rocket",
         "position": [
           "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
           "1.6 + sin(self.state.pitch) * 0.6",
           "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
         ],
         "overrides": {"state": {"velocity": [
           "-sin(self.state.facing) * cos(self.state.pitch) * 14",
           "sin(self.state.pitch) * 14",
           "-cos(self.state.facing) * cos(self.state.pitch) * 14"
         ]}}},
        {"type": "state_add", "target": "self", "field": "ammo", "amount": -5},
        {"type": "state_set", "target": "self", "field": "weapon_cooldown", "value": 15},
        {"type": "emit_shell_event", "event": "play_sound", "name": "rocket_launch"},
        {"type": "emit_shell_event", "event": "shake", "intensity": 0.04, "duration": 6}
      ]
    },

    {
      "_comment": "=== MONSTER AI: home toward player on XZ plane. Excludes ranger (uses ranger_homing instead — stops at fire_range). Imps + demons + boss all use this. Y kept at 0 (planar combat).",
      "id": "monster_homing",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["monster"], "tags_none": ["ranger"]},
        "b": {"tags_all": ["player"]},
        "radius": 1000
      },
      "effect": {
        "type": "velocity_set",
        "target": "a",
        "x": "(b.state.position.x - a.state.position.x) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 1) * a.properties.speed",
        "y": 0,
        "z": "(b.state.position.z - a.state.position.z) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 1) * a.properties.speed"
      }
    },

    {
      "_comment": "=== RANGER AI: home toward player ONLY when farther than fire_range (6m). Inside that radius, velocity → 0 (ranger plants and fires). Uses clamp-based step function (Godot 4.6.1 Expression doesn't honor `if/else` ternary in formulas — it parses but always returns the IF branch).",
      "id": "ranger_homing",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["ranger"]},
        "b": {"tags_all": ["player"]},
        "radius": 1000
      },
      "effect": {
        "type": "velocity_set",
        "target": "a",
        "x": "(b.state.position.x - a.state.position.x) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 0.1) * a.properties.speed * clamp((sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)) - a.properties.fire_range) * 1000, 0, 1)",
        "y": 0,
        "z": "(b.state.position.z - a.state.position.z) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 0.1) * a.properties.speed * clamp((sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)) - a.properties.fire_range) * 1000, 0, 1)"
      }
    },

    {
      "_comment": "Decrement ranger fire_cooldown each tick. tick_seconds=0.05 → cooldown reaches 0 in (1.5s / 0.05) = 30 ticks if reset to 1.5.",
      "id": "ranger_cooldown_tick",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["ranger"]},
      "effect": {"type": "state_add", "target": "self", "field": "fire_cooldown", "amount": -0.05}
    },

    {
      "_comment": "Ranger fires enemy_bullet when player in fire_range AND cooldown ≤ 0. once_per_a prevents duplicate per-pair fires. Bullet velocity = unit-vector toward player × 8 m/s.",
      "id": "ranger_fire",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["ranger"], "state": {"fire_cooldown_lte": 0.0}},
        "b": {"tags_all": ["player"]},
        "radius": 8.0,
        "once_per_a": true
      },
      "effect": [
        {"type": "spawn", "template": "enemy_bullet",
         "position": ["a.state.position.x", 1.0, "a.state.position.z"],
         "overrides": {"state": {"velocity": [
           "(b.state.position.x - a.state.position.x) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 0.1) * 8.0",
           0,
           "(b.state.position.z - a.state.position.z) / max(sqrt(pow(b.state.position.x - a.state.position.x, 2) + pow(b.state.position.z - a.state.position.z, 2)), 0.1) * 8.0"
         ]}}},
        {"type": "state_set", "target": "a", "field": "fire_cooldown", "value": "a.properties.fire_cooldown_max"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "shoot"}
      ]
    },

    {
      "_comment": "Enemy bullet hits player → -10 HP, red flash, hurt sound, bullet removed. Engine auto-decrements lifetime; bullet despawns at 0.",
      "id": "enemy_bullet_hits_player",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["enemy_bullet"]},
        "b": {"tags_all": ["player"]},
        "radius": 1.0
      },
      "effect": [
        {"type": "state_add", "target": "b", "field": "hp", "amount": -10},
        {"type": "state_clamp", "target": "b", "field": "hp", "min": 0, "max": 100},
        {"type": "remove", "target": "a"},
        {"type": "emit_shell_event", "event": "flash", "color": "#ff8040", "duration": 8},
        {"type": "emit_shell_event", "event": "play_sound", "name": "hurt"}
      ]
    },

    {
      "_comment": "=== COMBAT: bullet damages monster (damage scales with bullet.properties.damage so plasma=1, pellet=1, rocket=3) ===",
      "id": "bullet_kills_monster",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["bullet"]},
        "b": {"tags_all": ["monster"]},
        "radius": 1.2
      },
      "effect": [
        {"type": "state_add", "target": "b", "field": "hp", "amount": "-1 * a.properties.damage"},
        {"type": "remove", "target": "a"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "hit"}
      ]
    },

    {
      "_comment": "Monster death: hp ≤ 0 → 4 sparks (3D outward burst) + camera shake + score+1 + remove monster. Excludes boss (boss_killed_win runs first via 'before').",
      "id": "monster_death",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["monster"], "state": {"hp_lte": 0}},
      "effect": [
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.8, "self.state.position.z"],
         "overrides": {"state": {"velocity": [1.5, 1.0, 1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.8, "self.state.position.z"],
         "overrides": {"state": {"velocity": [-1.5, 1.0, 1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.8, "self.state.position.z"],
         "overrides": {"state": {"velocity": [1.5, 1.0, -1.5]}}},
        {"type": "spawn", "template": "particle_spark",
         "position": ["self.state.position.x", 0.8, "self.state.position.z"],
         "overrides": {"state": {"velocity": [-1.5, 1.0, -1.5]}}},
        {"type": "emit_shell_event", "event": "shake", "intensity": 0.06, "duration": 8},
        {"type": "emit_shell_event", "event": "play_sound", "name": "kill"},
        {"type": "state_add", "target": "player", "field": "score", "amount": 1},
        {"type": "remove", "target": "self"}
      ]
    },

    {
      "_comment": "Monster touches player → -10 HP + flash + shake + remove monster (kamikaze).",
      "id": "monster_hits_player",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["monster"]},
        "b": {"tags_all": ["player"]},
        "radius": 1.2
      },
      "effect": [
        {"type": "state_add", "target": "b", "field": "hp", "amount": -10},
        {"type": "state_clamp", "target": "b", "field": "hp", "min": 0, "max": 100},
        {"type": "emit_shell_event", "event": "flash", "color": "#ff0000", "duration": 12},
        {"type": "emit_shell_event", "event": "shake", "intensity": 0.1, "duration": 10},
        {"type": "emit_shell_event", "event": "play_sound", "name": "hurt"},
        {"type": "remove", "target": "a"}
      ]
    },

    {
      "_comment": "=== PICKUPS ===",
      "id": "pickup_health_grab",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["player"]},
        "b": {"tags_all": ["pickup_health"]},
        "radius": 1.2
      },
      "effect": [
        {"type": "state_add", "target": "a", "field": "hp", "amount": 25},
        {"type": "state_clamp", "target": "a", "field": "hp", "min": 0, "max": 100},
        {"type": "remove", "target": "b"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "pickup"}
      ]
    },

    {
      "id": "pickup_ammo_grab",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["player"]},
        "b": {"tags_all": ["pickup_ammo"]},
        "radius": 1.2
      },
      "effect": [
        {"type": "state_add", "target": "a", "field": "ammo", "amount": 5},
        {"type": "remove", "target": "b"},
        {"type": "emit_shell_event", "event": "play_sound", "name": "pickup"}
      ]
    },

    {
      "_comment": "=== SIGNATURE MOMENTS (v2) ===",
      "_": "Boss spawn check: when player.score ≥ 25 AND boss not yet spawned, spawn The Industrial Mover at the spawn ring. once_per_a on clock side; latch via boss_spawned=1.",
      "id": "boss_spawn_check",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["clock"], "state": {"boss_spawned": 0}},
        "b": {"tags_all": ["player"], "state": {"score_gte": 25}},
        "radius": 1000,
        "once_per_a": true
      },
      "effect": [
        {"type": "spawn", "template": "monster_boss",
         "position": [
           "cos(randf() * 6.28318) * 16",
           0,
           "sin(randf() * 6.28318) * 16"
         ]},
        {"type": "state_set", "target": "a", "field": "boss_spawned", "value": 1},
        {"type": "emit_shell_event", "event": "play_sound", "name": "boss_roar"},

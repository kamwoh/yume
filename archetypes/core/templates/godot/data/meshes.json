{
  "_comment": "3D mesh library (W5.0b). Composes engine MESH PRIMITIVES (box, sphere, cylinder, capsule, plane, prism, torus, quad — Godot's PrimitiveMesh classes). Each entry is a list of primitives with positions + sizes + $param substitution. Same authoring shape as shapes.json.",

  "meshes": {
    "tree": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.4, 0], "radius": 0.12, "height": 0.8, "color": "$trunk"},
        {"op": "sphere",   "pos": [0, 1.1, 0], "radius": 0.5,                 "color": "$foliage"}
      ],
      "params": {"foliage": "#3a8a3a", "trunk": "#6b3a1a"}
    },

    "rock": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0.3, 0], "radius": 0.35, "color": "$stone"}
      ],
      "params": {"stone": "#7a7a7a"}
    },

    "person": {
      "primitives": [
        {"op": "capsule", "pos": [0, 0.6, 0], "radius": 0.2, "height": 1.0, "color": "$shirt"},
        {"op": "sphere",  "pos": [0, 1.4, 0], "radius": 0.18,                "color": "$skin"}
      ],
      "params": {"shirt": "#5b9bff", "skin": "#e0b094"}
    },

    "water": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.05, 0], "radius": 0.6, "height": 0.1, "color": "$water"}
      ],
      "params": {"water": "#3b7fb8"}
    },

    "fire": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0.3, 0], "radius": 0.3, "color": "$flame_outer"},
        {"op": "sphere", "pos": [0, 0.5, 0], "radius": 0.18, "color": "$flame_inner"}
      ],
      "params": {"flame_outer": "#d94c1a", "flame_inner": "#ffe066"}
    },

    "building": {
      "primitives": [
        {"op": "box",   "pos": [0, 0.5, 0], "size": [1.6, 1.0, 1.2], "color": "$wall"},
        {"op": "prism", "pos": [0, 1.3, 0], "size": [1.8, 0.6, 1.4], "color": "$roof"}
      ],
      "params": {"wall": "#b8a98a", "roof": "#7a3a2a"}
    },

    "ash": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.05, 0], "radius": 0.3, "height": 0.1, "color": "$ash"}
      ],
      "params": {"ash": "#2a2618"}
    },

    "burning_tree": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.4, 0], "radius": 0.12, "height": 0.8, "color": "$char"},
        {"op": "sphere",   "pos": [0, 1.1, 0], "radius": 0.5,                 "color": "$flame"}
      ],
      "params": {"char": "#3a1810", "flame": "#d94c1a"}
    },

    "marker": {
      "primitives": [
        {"op": "box", "pos": [0, 0.05, 0], "size": [0.2, 0.1, 0.2], "color": "$mark"}
      ],
      "params": {"mark": "#aaaaaa"}
    },

    "imp_3d": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0.45, 0], "radius": 0.4, "color": "$body"},
        {"op": "sphere", "pos": [0.18, 0.6, 0.18], "radius": 0.07, "color": "$eye"},
        {"op": "sphere", "pos": [-0.18, 0.6, 0.18], "radius": 0.07, "color": "$eye"}
      ],
      "params": {"body": "#a02020", "eye": "#ffd040"}
    },

    "demon_3d": {
      "primitives": [
        {"op": "sphere",   "pos": [0, 0.7, 0], "radius": 0.6, "color": "$body"},
        {"op": "cylinder", "pos": [0.3, 1.2, 0], "radius": 0.06, "height": 0.3, "color": "$horn"},
        {"op": "cylinder", "pos": [-0.3, 1.2, 0], "radius": 0.06, "height": 0.3, "color": "$horn"}
      ],
      "params": {"body": "#601810", "horn": "#3a0a0a"}
    },

    "bolt_3d": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.18, "color": "$core"},
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.30, "color": "$tail"}
      ],
      "params": {"core": "#ffe060", "tail": "#ff8020"}
    },

    "spark_3d": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.10, "color": "$glow"},
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.05, "color": "$core"}
      ],
      "params": {"glow": "#ffe080", "core": "#ffffff"}
    },

    "med_kit_3d": {
      "primitives": [
        {"op": "box", "pos": [0, 0.25, 0],  "size": [0.5, 0.5, 0.5], "color": "$body"},
        {"op": "box", "pos": [0, 0.26, 0.26], "size": [0.3, 0.08, 0.02], "color": "$cross"},
        {"op": "box", "pos": [0, 0.26, 0.26], "size": [0.08, 0.3, 0.02], "color": "$cross"}
      ],
      "params": {"body": "#cc1818", "cross": "#ffffff"}
    },

    "ammo_box_3d": {
      "primitives": [
        {"op": "box", "pos": [0, 0.2, 0],  "size": [0.5, 0.4, 0.35], "color": "$body"},
        {"op": "box", "pos": [0, 0.42, 0], "size": [0.55, 0.04, 0.4], "color": "$band"}
      ],
      "params": {"body": "#e8c020", "band": "#806000"}
    },

    "wp_marker": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.05, 0], "radius": 0.4, "height": 0.1, "color": "$glow"}
      ],
      "params": {"glow": "#3a8a3a"}
    },

    "base_3d": {
      "primitives": [
        {"op": "box",  "pos": [0, 0.5, 0], "size": [2, 1, 2], "color": "$frame"},
        {"op": "box",  "pos": [0, 1.3, 0], "size": [1.4, 0.6, 1.4], "color": "$core"},
        {"op": "sphere", "pos": [0, 1.9, 0], "radius": 0.3, "color": "$core"}
      ],
      "params": {"core": "#1860d0", "frame": "#80b0ff"}
    },

    "grunt_3d": {
      "primitives": [
        {"op": "capsule", "pos": [0, 0.45, 0], "radius": 0.3, "height": 0.6, "color": "$body"},
        {"op": "sphere",  "pos": [0, 1.1, 0], "radius": 0.18, "color": "$body"},
        {"op": "cylinder","pos": [0.18, 1.25, 0], "radius": 0.04, "height": 0.18, "color": "$spike"},
        {"op": "cylinder","pos": [-0.18, 1.25, 0], "radius": 0.04, "height": 0.18, "color": "$spike"}
      ],
      "params": {"body": "#a02020", "spike": "#3a0a0a"}
    },

    "tower_3d": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.4, 0], "radius": 0.6, "height": 0.8, "color": "$base"},
        {"op": "box",      "pos": [0, 1.0, 0], "size": [0.6, 0.4, 0.6], "color": "$base"},
        {"op": "cylinder", "pos": [0, 1.25, 0.5], "radius": 0.12, "height": 0.6, "color": "$barrel"},
        {"op": "sphere",   "pos": [0, 1.55, 0], "radius": 0.12, "color": "$glow"}
      ],
      "params": {"base": "#404048", "barrel": "#a0a0b0", "glow": "#ffe060"}
    },

    "path_dot": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.02, 0], "radius": 0.18, "height": 0.04, "color": "$track"}
      ],
      "params": {"track": "#7050a0"}
    },

    "slot_ghost_mesh": {
      "primitives": [
        {"op": "cylinder", "pos": [0, 0.04, 0], "radius": 0.7, "height": 0.08, "color": "$glow"},
        {"op": "cylinder", "pos": [0, 0.05, 0], "radius": 0.5, "height": 0.02, "color": "#101020"}
      ],
      "params": {"glow": "#5050a0"}
    },

    "ranger_3d": {
      "primitives": [
        {"op": "capsule",  "pos": [0, 0.45, 0],   "radius": 0.28, "height": 0.55, "color": "$body"},
        {"op": "box",      "pos": [0, 1.05, 0],   "size": [0.45, 0.3, 0.45],       "color": "$body"},
        {"op": "sphere",   "pos": [0, 1.1, 0.22], "radius": 0.1,                   "color": "$lens"},
        {"op": "cylinder", "pos": [0.3, 0.85, 0.2], "radius": 0.05, "height": 0.5, "color": "$lens"}
      ],
      "params": {"body": "#603030", "lens": "#ff8040"}
    },

    "boss_3d": {
      "primitives": [
        {"op": "sphere",   "pos": [0, 1.0, 0],    "radius": 1.0, "color": "$body"},
        {"op": "sphere",   "pos": [0, 1.05, 0.6], "radius": 0.35, "color": "$core"},
        {"op": "cylinder", "pos": [0.55, 1.7, 0], "radius": 0.1,  "height": 0.55, "color": "$horn"},
        {"op": "cylinder", "pos": [-0.55, 1.7, 0], "radius": 0.1, "height": 0.55, "color": "$horn"},
        {"op": "box",      "pos": [0, 0.25, 0],   "size": [1.4, 0.5, 1.4], "color": "$horn"}
      ],
      "params": {"body": "#2a0a0a", "core": "#ff4040", "horn": "#1a0505"}
    },

    "enemy_bolt_3d": {
      "primitives": [
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.18, "color": "$core"},
        {"op": "sphere", "pos": [0, 0, 0], "radius": 0.30, "color": "$tail"}
      ],
      "params": {"core": "#ff4040", "tail": "#a02020"}
    }
  }
}

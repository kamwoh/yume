{
  "_comment": "W5.5 chess rules. NO tick logic — game advances purely via input/signal/relation. Move action: input 'move' with payload {piece, from_sq, to_sq}. white_move requires turn=white AND piece is white; black_move mirrors. Effect: unrelate old on_square edge, relate new edge, flip turn. Position-sync rule: on relation_changed (on_square added) → set piece position to its square's position (visual feedback). Demonstrates non-spatial game flow + Relation as primitive + require for context validation.",

  "rules": [
    {
      "id": "white_move",
      "trigger": {"type": "input", "action": "move"},
      "query": {"tags_all": ["game_state"], "state": {"turn_eq": "white"}},
      "require": {
        "piece": {"tags_all": ["white", "piece"]},
        "from_sq": {"tags_all": ["square"]},
        "to_sq": {"tags_all": ["square"]}
      },
      "effect": [
        {"type": "unrelate", "relation": "on_square", "from": "piece", "to": "from_sq"},
        {"type": "relate",   "relation": "on_square", "from": "piece", "to": "to_sq"},
        {"type": "state_set", "target": "self", "field": "turn", "value": "black"},
        {"type": "state_add", "target": "self", "field": "move_count", "amount": 1}
      ]
    },

    {
      "id": "black_move",
      "trigger": {"type": "input", "action": "move"},
      "query": {"tags_all": ["game_state"], "state": {"turn_eq": "black"}},
      "require": {
        "piece": {"tags_all": ["black", "piece"]},
        "from_sq": {"tags_all": ["square"]},
        "to_sq": {"tags_all": ["square"]}
      },
      "effect": [
        {"type": "unrelate", "relation": "on_square", "from": "piece", "to": "from_sq"},
        {"type": "relate",   "relation": "on_square", "from": "piece", "to": "to_sq"},
        {"type": "state_set", "target": "self", "field": "turn", "value": "white"},
        {"type": "state_add", "target": "self", "field": "move_count", "amount": 1}
      ]
    },

    {
      "id": "sync_piece_to_square_position",
      "_comment": "When a piece's on_square edge is added, update the piece's visual position to its square's position. Visual feedback for the move; no game logic.",
      "trigger": {"type": "relation_changed", "relation": "on_square", "change": "added"},
      "effect": {
        "type": "state_set",
        "target": "from",
        "field": "position",
        "value": "to.state.position"
      }
    }
  ]
}

{
  "_comment": "RPG WORLD physics (ADR 0009 Phase 3b). Player movement, attack swing, swing aging/death, swing-hits-enemy damage, enemy AI pursue + attack. Scoring (XP, level-up) and player/enemy death progression live in game/rules.json.",
  "rules": [
    {
      "id": "move_north",
      "trigger": {
        "type": "input",
        "action": "move_north"
      },
      "effect": {
        "type": "velocity_set",
        "target": "actor",
        "x": 0,
        "y": -90
      }
    },
    {
      "id": "move_south",
      "trigger": {
        "type": "input",
        "action": "move_south"
      },
      "effect": {
        "type": "velocity_set",
        "target": "actor",
        "x": 0,
        "y": 90
      }
    },
    {
      "id": "move_east",
      "trigger": {
        "type": "input",
        "action": "move_east"
      },
      "effect": {
        "type": "velocity_set",
        "target": "actor",
        "x": 90,
        "y": 0
      }
    },
    {
      "id": "move_west",
      "trigger": {
        "type": "input",
        "action": "move_west"
      },
      "effect": {
        "type": "velocity_set",
        "target": "actor",
        "x": -90,
        "y": 0
      }
    },
    {
      "id": "stop",
      "trigger": {
        "type": "input",
        "action": "stop"
      },
      "effect": {
        "type": "velocity_set",
        "target": "actor",
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "attack_swings_weapon",
      "trigger": {
        "type": "input",
        "action": "spark"
      },
      "effect": {
        "type": "spawn",
        "template": "weapon_swing",
        "position": "actor"
      }
    },
    {
      "id": "swing_ages",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "weapon",
          "transient"
        ]
      },
      "effect": {
        "type": "state_add",
        "target": "self",
        "field": "lifespan",
        "amount": -1
      }
    },
    {
      "id": "swing_dies",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "weapon",
          "transient"
        ],
        "state": {
          "lifespan_lte": 0
        }
      },
      "effect": {
        "type": "remove",
        "target": "self"
      }
    },
    {
      "id": "swing_hits_enemy",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "weapon"
          ]
        },
        "b": {
          "tags_all": [
            "enemy"
          ]
        },
        "radius": 45.0
      },
      "effect": {
        "type": "state_add",
        "target": "b",
        "field": "hp",
        "amount": "-a.state.damage"
      }
    },
    {
      "id": "enemy_ai_pursue_player",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "enemy"
          ]
        },
        "b": {
          "tags_all": [
            "player"
          ]
        },
        "radius": 800.0
      },
      "effect": {
        "type": "velocity_set",
        "target": "a",
        "x": "(b.state.position.x - a.state.position.x) * 0.3",
        "y": "(b.state.position.y - a.state.position.y) * 0.3"
      }
    },
    {
      "id": "enemy_attacks_player",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "enemy"
          ]
        },
        "b": {
          "tags_all": [
            "player"
          ]
        },
        "radius": 28.0
      },
      "chance": 0.15,
      "effect": {
        "type": "state_add",
        "target": "b",
        "field": "hp",
        "amount": -3
      }
    }
  ]
}
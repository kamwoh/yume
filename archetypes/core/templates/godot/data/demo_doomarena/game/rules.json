{
  "_comment": "DoomArena GAME rules (ADR 0009 Phase 3b). Wave clock + monster/pickup spawn pacing, score-on-kill. Subscribes to physics events; controls game-progression cadence.",
  "rules": [
    {
      "_comment": "=== CLOCK ===",
      "id": "clock_advance",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ]
      },
      "effect": [
        {
          "type": "state_add",
          "target": "self",
          "field": "elapsed",
          "amount": 0.1
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "spawn_timer",
          "amount": -0.1
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "pickup_timer",
          "amount": -0.1
        }
      ]
    },
    {
      "_comment": "Spawn imp at random edge when timer \u2264 0. Reset interval shortens with elapsed time (4s \u2192 2s by t=60).",
      "id": "monster_spawn",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "spawn_timer_lt": 0.0
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "monster_imp",
          "position": [
            "(randf() - 0.5) * 600",
            "(randf() - 0.5) * 460"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "spawn_timer",
          "value": "max(2.0, 4.0 - self.state.elapsed * 0.022)"
        }
      ]
    },
    {
      "id": "pickup_spawn_health",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "pickup_timer_lt": 0.0
        }
      },
      "chance": 0.5,
      "effect": [
        {
          "type": "spawn",
          "template": "health_pickup",
          "position": [
            "(randf() - 0.5) * 500",
            "(randf() - 0.5) * 380"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "pickup_timer",
          "value": 7.0
        }
      ]
    },
    {
      "id": "pickup_spawn_ammo",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "pickup_timer_lt": 0.0
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "ammo_pickup",
          "position": [
            "(randf() - 0.5) * 500",
            "(randf() - 0.5) * 380"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "pickup_timer",
          "value": 7.0
        }
      ]
    },
    {
      "_comment": "=== COMBAT: bullet damages monster ===",
      "id": "bullet_kills_monster",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "bullet"
          ]
        },
        "b": {
          "tags_all": [
            "monster"
          ]
        },
        "radius": 18
      },
      "effect": [
        {
          "type": "state_add",
          "target": "b",
          "field": "hp",
          "amount": -1
        },
        {
          "type": "remove",
          "target": "a"
        }
      ]
    }
  ]
}
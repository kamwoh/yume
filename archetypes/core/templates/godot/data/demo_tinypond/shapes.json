{
  "_comment": "TinyPond shapes — bumped to legible sizes after first user playtest. Originals were 3-6px (invisible at zoom 1.5x). Now 12-30px composites, distinct silhouettes.",

  "shapes": {
    "invisible_marker": {
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 1, "color": "$color"}
      ],
      "params": {"color": "#00000000"}
    },

    "tinypond_pond_water": {
      "_comment": "Background lily pad — decorative anchor for spatial reference.",
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 22, "color": "$pad"},
        {"op": "circle", "pos": [-6, -4], "radius": 4, "color": "$flower"},
        {"op": "circle", "pos": [6, 4], "radius": 4, "color": "$flower"}
      ],
      "params": {"pad": "#2a5a4a", "flower": "#e0c8a0"}
    },

    "tinypond_sun": {
      "_comment": "Static sun marker at top — orients player; doesn't change brightness in v1.",
      "primitives": [
        {"op": "circle", "pos": [0, 0], "radius": 28, "color": "$glow"},
        {"op": "circle", "pos": [0, 0], "radius": 20, "color": "$core"}
      ],
      "params": {"glow": "#ffd470", "core": "#fff8a0"}
    },

    "tinypond_plant_seed": {
      "_comment": "Sprout — small but visible. Two-leaf silhouette so it reads as 'plant baby'.",
      "primitives": [
        {"op": "rect",   "pos": [-1, -2], "size": [2, 8], "color": "$stem"},
        {"op": "circle", "pos": [-4, -4], "radius": 5, "color": "$leaf"},
        {"op": "circle", "pos": [ 4, -4], "radius": 5, "color": "$leaf"}
      ],
      "params": {"stem": "#5a8a3a", "leaf": "#9eda6a"}
    },

    "tinypond_plant_mature": {
      "_comment": "Mature plant — bigger composite with darker green and a flower. Distinct from seedling.",
      "primitives": [
        {"op": "rect",   "pos": [-2, 0],  "size": [4, 16], "color": "$stem"},
        {"op": "circle", "pos": [-9, -4], "radius": 9, "color": "$leaf"},
        {"op": "circle", "pos": [ 9, -4], "radius": 9, "color": "$leaf"},
        {"op": "circle", "pos": [ 0, -14], "radius": 11, "color": "$leaf"},
        {"op": "circle", "pos": [ 0, -14], "radius": 5, "color": "$flower"}
      ],
      "params": {"stem": "#3a6a2a", "leaf": "#5ea848", "flower": "#ffaa50"}
    },

    "tinypond_fish": {
      "_comment": "Fish — clearly fish-shaped. Body ellipse-ish, distinct tail triangle, eye dot.",
      "primitives": [
        {"op": "circle", "pos": [-2, 0], "radius": 14, "color": "$body"},
        {"op": "rect",   "pos": [-22, -5], "size": [12, 10], "color": "$tail"},
        {"op": "circle", "pos": [6, -3], "radius": 3, "color": "$eyewhite"},
        {"op": "circle", "pos": [7, -3], "radius": 1.5, "color": "$pupil"}
      ],
      "params": {"body": "#e88030", "tail": "#c06010", "eyewhite": "#ffffff", "pupil": "#000000"}
    }
  }
}

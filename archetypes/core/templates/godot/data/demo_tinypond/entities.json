{
  "_comment": "TinyPond — verification run for Tier 2.6g skill pipeline. 4 defs, 16 instances, 9 rules. Pond_clock broadcasts sunlight via contact; fish drift + eat; plants grow in sun + occasionally seed.",

  "definitions": [
    {
      "_comment": "Singleton meta entity. Owns time_of_day + sunlight state. Plants read sunlight via contact (radius 1000 = entire pond). Visual = sun marker — static yellow disc at top of screen so player sees there's a 'sky'.",
      "id": "pond_clock",
      "tags": ["clock", "meta"],
      "properties": {},
      "state_init": {
        "time_of_day": 0.0,
        "sunlight": 0.0
      },
      "visual": {
        "shape": "tinypond_sun",
        "params": {"glow": "#ffd470", "core": "#fff8a0"}
      }
    },
    {
      "_comment": "Decorative lily pad — purely visual anchor so the pond doesn't look like void.",
      "id": "lily_pad",
      "tags": ["decor"],
      "properties": {},
      "state_init": {},
      "visual": {
        "shape": "tinypond_pond_water",
        "params": {"pad_dark": "#1f4538", "pad": "#3d7a5e", "flower": "#f5b8d4", "flower_core": "#fff4cc"}
      }
    },
    {
      "_comment": "Water sprout — small green shoot just emerging from the bed. Inedible until it matures. Grows when in sunlight.",
      "id": "water_plant_seed",
      "tags": ["plant", "seed"],
      "properties": {
        "grow_rate": 5
      },
      "state_init": {
        "growth": 0.0,
        "sunlight": 0.0
      },
      "visual": {
        "shape": "tinypond_plant_seed",
        "params": {"base": "#2c5a3a", "stem": "#3d7a4d", "leaf": "#6db86d"}
      }
    },
    {
      "_comment": "Mature kelp/seaweed — full underwater plant with flowing fronds. Has 'edible' tag so fish-eat rule fires.",
      "id": "water_plant_mature",
      "tags": ["plant", "mature", "edible"],
      "properties": {},
      "state_init": {},
      "visual": {
        "shape": "tinypond_plant_mature",
        "params": {"base": "#1a3826", "stem": "#2c5a3a", "frond": "#3d7a4d", "frond_d": "#2c5a3a", "tip": "#6db86d"}
      }
    },
    {
      "_comment": "Ambient fish — drift around, eat mature plants on contact. Tagged 'fish' so the random-walk rule targets it; tagged 'creature' so both fish + player can eat plants.",
      "id": "fish",
      "tags": ["fish", "creature"],
      "properties": {},
      "state_init": {
        "hunger": 30.0,
        "velocity": [0, 0],
        "time_of_day": 0.0
      },
      "visual": {
        "shape": "tinypond_fish",
        "flip_with_velocity": true,
        "params": {"body": "#d8a040", "tail": "#a07020", "eyewhite": "#ffffff", "pupil": "#000000"}
      }
    },
    {
      "_comment": "Player fish — controlled via WASD. Tagged 'player' so input rules' actor=>self resolution targets this entity. Tagged 'creature' so the eating rule fires on contact with plants. Visually distinct (cyan/blue) so user can find it.",
      "id": "player_fish",
      "tags": ["player", "creature"],
      "properties": {},
      "state_init": {
        "hunger": 30.0,
        "velocity": [0, 0],
        "score": 0,
        "time_of_day": 0.0
      },
      "visual": {

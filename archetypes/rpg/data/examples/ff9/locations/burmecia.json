      "dialogues_by_quest": {
        "default": "...my home. I can still hear the rain falling on the streets I grew up in.",
        "fall_of_burmecia:0": "My home... what have they done to my home? Kuja... I saw him here, watching the destruction like entertainment.",
        "fall_of_burmecia:1": "We must press on to the palace. If there are survivors, that's where they'll be.",
        "fall_of_burmecia:2": "Fratley... where are you? I need your strength now more than ever.",
        "after:fall_of_burmecia": "Burmecia will rise again. The dragon knights will not be forgotten.",
        "fratleys_memory:0": "Fratley's belongings might still be in the ruins. Help me search... please.",
        "after:fratleys_memory": "I found traces of him. He was here... and he survived. I know it."
      }
    }

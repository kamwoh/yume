# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp

# Project planning (findings/progress are session-specific)
findings.md
progress.md
session_log.txt
.vqa.log
CHANGELOG.md

# Capture screenshots — local artifacts, regenerable via play.sh --capture
captures/

# Per-game demo content + per-game scene launchers — generate locally via
# /yume-design or copy from upstream. The framework keeps only:
#   godot/scenes/play.tscn         (universal launcher with --game= arg)
#   godot/scenes/test_main.tscn    (engine unit tests)
#   godot/scenes/scenario_test.tscn (per-game scenario test runner)
# And shared engine data libraries:
#   godot/data/shapes.json, meshes.json, sounds.json
godot/data/demo_*/
godot/data/entities.json
godot/scenes/*.tscn
!godot/scenes/play.tscn
!godot/scenes/test_main.tscn
!godot/scenes/scenario_test.tscn
!godot/scenes/asset_preview.tscn

# Per-game design docs (GDD, world-plan, level-design, reviews, QA reports).
# These are local artifacts produced by /yume-design pipeline; they pair with
# the gitignored godot/data/demo_<name>/ folders.
docs/games/

# User saves (Godot user:// resolves to platform appdata, but if anyone
# sets data_root to a tracked path, this prevents leakage)
godot/data/*/saves/

# Generated output
output/

# Archive (old code, not needed)
_archive/

# Raw scraped data (large, copyrighted)
docs/ff9_raw/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Visual QA reports — per-run artifacts, regenerate via tools/visual_qa/run_plan.py
tools/visual_qa/sample_plans/visual_test_report/
tools/visual_qa/**/visual_test_report/
tools/visual_qa/plans/

# ADR 0058: compiled shaders from tools/yume_shadergen — regenerate from scene.json shader_template + template
godot/data/demo_*/assets/shaders/

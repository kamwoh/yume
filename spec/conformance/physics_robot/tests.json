{
  "_comment": "Physics is host-defined (ADR 0086), so each check is a guarantee with a margin. The readback field names, the sensor fields, the miss value (exactly the range) and the masks are exact.",
  "scenarios": [
    {
      "name": "settles_and_senses",
      "_": "On its wheels after 30 ticks. The front ray, at the chassis front, reads the wall at 3.24 m. The lidar, at the chassis center, reads it at 3.45 m. The npc-only ray misses and reads exactly its range.",
      "steps": [
        {
          "tick": 30
        },
        {
          "expect": [
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.y",
                "op": ">",
                "value": 0.1
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.y",
                "op": "<",
                "value": 0.2
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.front_hit",
                "op": "==",
                "value": 1
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.front_distance",
                "op": ">",
                "value": 3.19
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.front_distance",
                "op": "<",
                "value": 3.29
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.blind_distance",
                "op": "==",
                "value": 5.0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.blind_hit",
                "op": "==",
                "value": 0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.lidar_min",
                "op": ">",
                "value": 3.4
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.lidar_min",
                "op": "<",
                "value": 3.5
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.lidar_min_angle",
                "op": ">",
                "value": -0.01
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.lidar_min_angle",
                "op": "<",
                "value": 0.01
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_angle",
                "op": ">",
                "value": -0.2
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_angle",
                "op": "<",
                "value": 0.2
              }
            }
          ]
        }
      ]
    },
    {
      "name": "drives_straight",
      "_": "Hold W for 1 s: both wheels turn forward and the robot moves toward -Z in a straight line.",
      "steps": [
        {
          "tick": 20
        },
        {
          "hold": "move_north",
          "for": 1.0
        },
        {
          "expect": [
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.z",
                "op": "<",
                "value": 0.7
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.x",
                "op": ">",
                "value": -0.1
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.x",
                "op": "<",
                "value": 0.1
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_speed",
                "op": ">",
                "value": 5.0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_r_angle",
                "op": ">",
                "value": 3.0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.front_distance",
                "op": "<",
                "value": 3.0
              }
            }
          ]
        }
      ]
    },
    {
      "name": "turns_in_place",
      "_": "Hold A for 1 s: the left wheel turns back, the right wheel forward, and the yaw grows. The chassis center circles the axle, so z has a margin of 0.3 m, as in the rover demo.",
      "steps": [
        {
          "tick": 20
        },
        {
          "hold": "move_west",
          "for": 1.0
        },
        {
          "expect": [
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.yaw",
                "op": ">",
                "value": 0.5
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_speed",
                "op": "<",
                "value": -2.0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.z",
                "op": ">",
                "value": 0.7
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.position.z",
                "op": "<",
                "value": 1.3
              }
            }
          ]
        }
      ]
    },
    {
      "name": "release_stops",
      "_": "Hold W, then release for 1 s: the mixer clears the commands, and the motors stop the wheels.",
      "steps": [
        {
          "tick": 20
        },
        {
          "hold": "move_north",
          "for": 0.5
        },
        {
          "tick": 60
        },
        {
          "expect": [
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.left_cmd",
                "op": "==",
                "value": 0.0
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_speed",
                "op": "<",
                "value": 0.5
              }
            },
            {
              "entity_field": {
                "id": "robot_1",
                "field": "state.wheel_l_speed",
                "op": ">",
                "value": -0.5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "contact_with_a_body",
      "_": "A contact rule pairs the robot with the marker by radius, from the position that physics writes.",
      "steps": [
        {
          "tick": 20
        },
        {
          "hold": "move_north",
          "for": 1.5
        },
        {
          "expect": [
            {
              "entity_field": {
                "id": "score",
                "field": "state.found",
                "op": "==",
                "value": 1
              }
            },
            {
              "entity_count": {
                "query": {
                  "tags_all": [
                    "marker"
                  ]
                },
                "op": "==",
                "value": 0
              }
            }
          ]
        }
      ]
    }
  ]
}

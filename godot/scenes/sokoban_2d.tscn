[gd_scene load_steps=5 format=3]

; Sokoban — top-down 2D grid. Camera position + zoom are computed each
; frame from data/demo_sokoban/scene.json's camera config (center_on_tag
; "floor" + fit_padding) so the whole level fits the viewport regardless
; of size. No need to hardcode position/zoom here.

[ext_resource type="Script" path="res://scripts/engine/world.gd" id="1"]
[ext_resource type="Script" path="res://scripts/engine/game_shell.gd" id="2"]
[ext_resource type="Script" path="res://scripts/engine/screen_flow.gd" id="3"]
[ext_resource type="Script" path="res://scripts/engine/overlay.gd" id="4"]
[ext_resource type="Script" path="res://scripts/engine/settings_manager.gd" id="5"]

[node name="World" type="Node"]
script = ExtResource("1")
data_root = "res://data/demo_sokoban"
auto_start = true
verbose = true
renderer_script = "res://scripts/renderer_2d/entity_sprite_2d.gd"
; Input edge classification (turn-based press-edge for sokoban) lives in
; data/demo_sokoban/inputs.json — engine has no baked-in defaults.
stop_action_on_idle = ""

[node name="GameShell" type="Node" parent="."]
script = ExtResource("2")

; ADR 0011: ScreenFlow loads data/demo_sokoban/screens.json (title / game /
; pause). When current_screen != "game", world ticks are suppressed.
[node name="ScreenFlow" type="Node" parent="."]
script = ExtResource("3")

; ADR 0012: OverlayManager renders tutorial overlays + manages advance
; conditions. No-op until a show_overlay effect fires.
[node name="OverlayManager" type="Node" parent="."]
script = ExtResource("4")

; ADR 0013: SettingsManager loads data/demo_sokoban/settings_schema.json +
; user://settings.cfg. apply_all() runs once World env is built.
[node name="SettingsManager" type="Node" parent="."]
script = ExtResource("5")

[node name="Camera2D" type="Camera2D" parent="."]

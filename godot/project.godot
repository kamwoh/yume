; Yume framework template — universal simulation engine.
; Minimal project config. Downstream games copy from here and customize data/.
;
; Contract: docs/30_framework_primitives.md
; Plan:     task_plan.md

config_version=5

[application]

config/name="Yume Framework"
config/description="Universal JSON-driven simulation framework"
config/features=PackedStringArray("4.6")
run/main_scene="res://scenes/play.tscn"

[rendering]

renderer/rendering_method="gl_compatibility"

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[autoload]

CaptureRunner="*res://scripts/engine/io/capture_runner.gd"
AudioBus="*res://scripts/engine/io/audio_bus.gd"
StdioStepDriver="*res://scripts/engine/io/stdio_step_driver.gd"
LockstepDriver="*res://scripts/engine/io/lockstep_driver.gd"

; Input bindings live in per-game data/demo_X/ui/input.json. The universal
; WASD + Arrow movement set is shared via data/lib/input/universal.json
; (ADR 0043) — each game's ui/input.json $includes it. project.godot stays
; framework-only; no game-specific config here. Invariant #1.

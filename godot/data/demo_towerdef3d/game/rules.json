    {
      "_comment": "=== BASE DAMAGE ===",
      "_": "Enemy reaches base \u2192 -1 base.hp, shake, decrement enemies_alive, remove enemy.",
      "id": "enemy_at_base",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "enemy"
          ]
        },
        "b": {
          "tags_all": [
            "base"
          ]
        },
        "radius": 0.8
      },
      "effect": [
        {
          "type": "state_add",
          "target": "b",
          "field": "hp",
          "amount": -1
        },
        {
          "type": "emit_shell_event",
          "event": "shake",
          "intensity": 0.08,
          "duration": 8
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "hurt"
        },
        {
          "type": "state_add",
          "target": "clock_1",
          "field": "enemies_alive",
          "amount": -1
        },
        {
          "type": "remove",
          "target": "a"
        }
      ]

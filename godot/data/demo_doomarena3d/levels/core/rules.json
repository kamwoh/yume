{
  "_comment": "Chamber 3 (Core Containment) per-chamber rules. Boss is pre-spawned in entities.json \u2014 no spawn rule needed. Supplemental imps every 4s. Boss intro beat fires once when clock is fresh. Boss-kill clears (engine sets world.all_levels_complete after last level transition).",
  "rules": [
    {
      "_comment": "BOSS INTRO BEAT \u2014 fires once when chamber 3 is freshly loaded (boss_spawned latch starts at 0). Plays boss_roar + flash + shake. Sets boss_spawned=1 to latch.",
      "id": "core_boss_intro",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "clock"
          ],
          "state": {
            "boss_spawned": 0
          }
        },
        "b": {
          "tags_all": [
            "player"
          ]
        },
        "radius": 1000,
        "once_per_a": true
      },
      "effect": [
        {
          "type": "state_set",
          "target": "a",
          "field": "boss_spawned",
          "value": 1
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "boss_roar"
        },
        {
          "type": "emit_shell_event",
          "event": "shake",
          "intensity": 0.15,
          "duration": 20
        },
        {
          "type": "emit_shell_event",
          "event": "flash",
          "color": "#400000",
          "duration": 24
        }
      ]
    },
    {
      "_comment": "Supplemental imp spawn every 4s \u2014 keeps pressure on while player engages boss. Slower than chamber 2 imp rate so boss is the primary focus.",
      "id": "core_imp_spawn",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "spawn_timer_lt": 0.0,
          "spawn_count_lt": 30
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "monster_imp",
          "position": [
            "cos(randf() * 6.28318) * 16",
            0,
            "sin(randf() * 6.28318) * 16"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "spawn_timer",
          "value": 4.0
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "spawn_count",
          "amount": 1
        }
      ]
    },
    {
      "id": "core_pickup_spawn_health",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "pickup_timer_lt": 0.0
        }
      },
      "chance": 0.5,
      "effect": [
        {
          "type": "spawn",
          "template": "health_pickup",
          "position": [
            "(randf() - 0.5) * 32",
            0.5,
            "(randf() - 0.5) * 32"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "pickup_timer",
          "value": 7.0
        }
      ]
    },
    {
      "id": "core_pickup_spawn_ammo",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ],
        "state": {
          "pickup_timer_lt": 0.0
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "ammo_pickup",
          "position": [
            "(randf() - 0.5) * 32",
            0.5,
            "(randf() - 0.5) * 32"
          ]
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "pickup_timer",
          "value": 7.0
        }
      ]
    },
    {
      "_comment": "CHAMBER CLEAR (FINALE): boss hp \u2264 0. Runs BEFORE monster_death (which removes the boss). Plays win cascade + transition_level next \u2192 engine sets world.all_levels_complete=1 \u2192 HUD wins via existing binding.",
      "id": "core_clear",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "boss"
        ],
        "state": {
          "hp_lte": 0
        }
      },
      "before": [
        "monster_death"
      ],
      "effect": [
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "win"
        },
        {
          "type": "emit_shell_event",
          "event": "shake",
          "intensity": 0.3,
          "duration": 30
        },
        {
          "type": "emit_shell_event",
          "event": "flash",
          "color": "#ffffe0",
          "duration": 30
        },
        {
          "type": "transition_level",
          "target": "next"
        }
      ]
    }
  ]
}
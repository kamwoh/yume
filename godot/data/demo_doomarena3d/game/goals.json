{
  "_comment": "DoomArena3D GAME rules (ADR 0009 Phase 3b). Wave clock + score-on-kill. Subscribes to physics events.",
  "rules": [
    {
      "_comment": "=== CLOCK \u2014 universal: advance elapsed and decrement all timers each tick. Per-chamber clocks have their own elapsed=0 starting point.",
      "id": "clock_advance",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "clock"
        ]
      },
      "effect": [
        {
          "type": "state_add",
          "target": "self",
          "field": "elapsed",
          "amount": 0.05
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "spawn_timer",
          "amount": -0.05
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "demon_timer",
          "amount": -0.05
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "ranger_timer",
          "amount": -0.05
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "pickup_timer",
          "amount": -0.05
        }
      ]
    },
    {
      "_comment": "=== WEAPON COOLDOWN tick.",
      "id": "weapon_cooldown_tick",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "player"
        ],
        "state": {
          "weapon_cooldown_gt": 0
        }
      },
      "effect": {
        "type": "state_add",
        "target": "self",
        "field": "weapon_cooldown",
        "amount": -1
      }
    },
    {
      "id": "ranger_cooldown_tick",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "ranger"
        ]
      },
      "effect": {
        "type": "state_add",
        "target": "self",
        "field": "fire_cooldown",
        "amount": -0.05
      }
    },
    {
      "_comment": "=== COMBAT: bullet damages monster (damage scales with bullet.properties.damage)",
      "id": "bullet_kills_monster",
      "trigger": {
        "type": "contact"
      },
      "query": {
        "a": {
          "tags_all": [
            "bullet"
          ]
        },
        "b": {
          "tags_all": [
            "monster"
          ]
        },
        "radius": 1.2
      },
      "effect": [
        {
          "type": "state_add",
          "target": "b",
          "field": "hp",
          "amount": "-1 * a.properties.damage"
        },
        {
          "type": "remove",
          "target": "a"
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "hit"
        }
      ]
    }
  ]
}
{
  "_comment": "Game-specific scenario tests for doomarena3d v3.0 (3-chamber campaign, ADR 0006). Each scenario builds a fresh World, applies setup, ticks forward, injects scripted inputs, then asserts. v3.0 changes vs v2.6: clock instance is per-chamber (clock_outer/clock_foundry/clock_core), boss is pre-spawned in chamber 3 (no score=25 trigger), win = world.all_levels_complete (was clock.boss_killed). New: multi-chamber transition tests.",
  "scenarios": [
    {
      "_section": "=== STARTUP ===",
      "name": "starts_in_outer_chamber",
      "_": "v3.0: world.current_level should be 'outer' immediately after load (progression.starting_level).",
      "setup": {},
      "steps": [
        {
          "tick": 1
        },
        {
          "expect": [
            {
              "world_field": {
                "field": "current_level",
                "op": "==",
                "value": "outer"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "player_has_persistent_tag",
      "_": "v3.0: player def tagged 'persistent' (ADR 0006) so HP/ammo/score survive transitions.",
      "setup": {},
      "steps": [
        {
          "tick": 1
        },
        {
          "expect": [
            {
              "entity_count": {
                "query": {
                  "tags_all": [
                    "player",
                    "persistent"
                  ]
                },
                "op": "==",
                "value": 1
              }
            }
          ]
        }
      ]
    },
    {
      "_section": "=== COMBAT (PLASMA) ===",
      "name": "bullet_spawns_on_fire",
      "_": "Pressing SPACE (spark) on tick 1 should spawn exactly 1 bullet.",
      "setup": {
        "entity_state": {
          "player": {
            "facing": 0,
            "pitch": 0,
            "ammo": 5,
            "position": [
              0,
              0,
              0
            ]
          }
        }
      },
      "steps": [
        {
          "press": "spark"
        },
        {
          "tick": 2
        },
        {
          "expect": [
            {
              "entity_count": {
                "query": {
                  "tags_all": [
                    "bullet"
                  ]
                },
                "op": "==",
                "value": 1
              }
            }
          ]
        }
      ]
    },
    {
      "name": "bullet_moves_after_fire",
      "_": "REGRESSION: bullet velocity must be Vector3, not Vector3.ZERO. At facing=pitch=0, forward = -Z. After 8 ticks, bullet should be at z < -1.",
      "setup": {
        "entity_state": {
          "player": {
            "facing": 0,
            "pitch": 0,
            "ammo": 5,
            "position": [
              0,
              0,
              0
            ]
          }
        }
      },
      "steps": [
        {
          "press": "spark"
        },
        {
          "tick": 7
        },
        {
          "expect": [
            {
              "entity_count": {
                "query": {
                  "tags_all": [
                    "bullet"
                  ]
                },
                "op": ">=",
                "value": 1
              }
            },
            {
              "entity_field": {
                "query": {
                  "tags_all": [
                    "bullet"
                  ]
                },
                "field": "state.position.z",
                "op": "<",
                "value": -1.0
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ammo_decrements_on_fire",
      "_": "Each fire reduces ammo by 1. Start at 5, fire 3 times \u2192 2.",
      "setup": {
        "entity_state": {
          "player": {
            "facing": 0,
            "pitch": 0,
            "ammo": 5,
            "position": [
              0,
              0,
              0
            ]
          }
        }
      },
      "steps": [
        {
          "hold": "spark",
          "for": 0.15
        },
        {
          "tick": 1
        },
        {
          "expect": [
            {
              "entity_field": {
                "query": {
                  "tags_all": [
                    "player"
                  ]
                },
                "field": "state.ammo",
                "op": "==",
                "value": 2
              }
            }
          ]
        }
      ]
    },
    {
      "name": "bullet_flies_up_when_aiming_up",
      "_": "REGRESSION: positive pitch = looking up. At pitch=0.5, bullet should rise \u2014 y > 3.0 after 8 ticks.",
      "setup": {
        "entity_state": {
          "player": {
            "facing": 0,
            "pitch": 0.5,
            "ammo": 5,
            "position": [
              0,
              0,
              0
            ]
          }
        }
      },
      "steps": [
        {
          "press": "spark"
        },
        {
          "tick": 7
        },
        {
          "expect": [
            {
              "entity_field": {
                "query": {
                  "tags_all": [
                    "bullet"
                  ]
                },
                "field": "state.position.y",
                "op": ">",
                "value": 3.0
              }
            }
          ]
        }
      ],
      "_known_limitation": "KNOWN-FAIL (2026-06-06): projectiles use character_projectile bodies (the only Yume body that moves visibly live+headless). The character runner owns velocity.y (gravity/jump channel), so pitch-aimed shots fly FLAT \u2014 horizontal motion works (see bullet_moves_after_fire), vertical does not. doomarena3d's enemies are all ground-based so this is gameplay-irrelevant. Proper fix = a free-3D-velocity projectile (rigid body + a body->state position readback, or a 'free mover' body type) \u2014 tracked for a future ADR. Do NOT mask this by relaxing the assertion; it documents the gap."
    },
    {
      "name": "fire_blocked_when_no_ammo",
      "_": "ammo=0 \u2192 fire rule's `state.ammo_gt: 0` query fails \u2192 no bullet.",

{
  "_comment": "Game-specific scenario tests for doomarena3d v3.0 (3-chamber campaign, ADR 0006). Each scenario builds a fresh World, applies setup, ticks forward, injects scripted inputs, then asserts. v3.0 changes vs v2.6: clock instance is per-chamber (clock_outer/clock_foundry/clock_core), boss is pre-spawned in chamber 3 (no score=25 trigger), win = world.all_levels_complete (was clock.boss_killed). New: multi-chamber transition tests.",

  "scenarios": [

    {
      "_section": "=== STARTUP ===",
      "name": "starts_in_outer_chamber",
      "_": "v3.0: world.current_level should be 'outer' immediately after load (progression.starting_level).",
      "setup": {},
      "actions": [],
      "ticks": 1,
      "assertions": [
        {"type": "world_field", "field": "current_level", "op": "==", "value": "outer"}
      ]
    },

    {
      "name": "player_has_persistent_tag",
      "_": "v3.0: player def tagged 'persistent' (ADR 0006) so HP/ammo/score survive transitions.",
      "setup": {},
      "actions": [],
      "ticks": 1,
      "assertions": [
        {"type": "entity_count",
         "query": {"tags_all": ["player", "persistent"]},
         "op": "==", "value": 1}
      ]
    },

    {
      "_section": "=== COMBAT (PLASMA) ===",
      "name": "bullet_spawns_on_fire",
      "_": "Pressing SPACE (spark) on tick 1 should spawn exactly 1 bullet.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 3,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": "==", "value": 1}
      ]
    },

    {
      "name": "bullet_moves_after_fire",
      "_": "REGRESSION: bullet velocity must be Vector3, not Vector3.ZERO. At facing=pitch=0, forward = -Z. After 8 ticks, bullet should be at z < -1.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 8,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": ">=", "value": 1},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["bullet"]},
         "field": "state.position.z", "op": "<", "value": -1.0}
      ]
    },

    {
      "name": "ammo_decrements_on_fire",
      "_": "Each fire reduces ammo by 1. Start at 5, fire 3 times → 2.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"},
        {"tick": 2, "input": "spark"},
        {"tick": 3, "input": "spark"}
      ],
      "ticks": 4,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.ammo", "op": "==", "value": 2}
      ]
    },

    {
      "name": "bullet_flies_up_when_aiming_up",
      "_": "REGRESSION: positive pitch = looking up. At pitch=0.5, bullet should rise — y > 3.0 after 8 ticks.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0.5, "ammo": 5, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 8,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["bullet"]},
         "field": "state.position.y", "op": ">", "value": 3.0}
      ]
    },

    {
      "name": "fire_blocked_when_no_ammo",
      "_": "ammo=0 → fire rule's `state.ammo_gt: 0` query fails → no bullet.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 0, "position": [0, 0, 0]}
        }
      },
      "actions": [
        {"tick": 1, "input": "spark"}
      ],
      "ticks": 3,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["bullet"]},
         "op": "==", "value": 0}
      ]
    },

    {
      "_section": "=== AI: MONSTER HOMING ===",
      "name": "monster_homes_toward_player",
      "_": "Spawn imp at (10, 0, -5) — chamber 1 forward zone. After 10 ticks (0.5s) imp should move toward player. Speed=3.5 m/s × 0.5s = 1.75m closer; permissive bound x < 9.5.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]}
        },
        "spawn": [
          {"def": "monster_imp", "id": "test_imp", "position": [10, 0, -5]}
        ]
      },
      "actions": [],
      "ticks": 10,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": ">=", "value": 1},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["monster"]},
         "field": "state.position.x", "op": "<", "value": 9.5}
      ]
    },

    {
      "name": "monster_reaches_and_kills_player",
      "_": "Imp at (4, 0, -8). After 80 ticks (4s), imp should reach player → imp removed, player HP -10. Disable chamber 1 spawn timer to prevent rule-spawned imps from polluting the count.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]},
          "clock_outer": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_imp", "id": "test_imp", "position": [4, 0, -8]}
        ]
      },
      "actions": [],
      "ticks": 80,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"]},
         "op": "==", "value": 0},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "five_imps_all_home",
      "_": "5 imps from different angles. Spawn rules disabled via clock_outer. After 50 ticks (2.5s) each imp should have moved toward origin.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]},
          "clock_outer": {"spawn_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_imp", "id": "imp_a", "position": [10, 0, -5]},
          {"def": "monster_imp", "id": "imp_b", "position": [-10, 0, -5]},
          {"def": "monster_imp", "id": "imp_c", "position": [0, 0, 12]},
          {"def": "monster_imp", "id": "imp_d", "position": [0, 0, -10]},
          {"def": "monster_imp", "id": "imp_e", "position": [3, 0, -16]}
        ]
      },
      "actions": [],
      "ticks": 50,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "imp_a",
         "field": "state.position.x", "op": "<", "value": 9},
        {"type": "entity_field", "select": "by_id", "id": "imp_b",
         "field": "state.position.x", "op": ">", "value": -9},
        {"type": "entity_field", "select": "by_id", "id": "imp_c",
         "field": "state.position.z", "op": "<", "value": 11},
        {"type": "entity_field", "select": "by_id", "id": "imp_d",
         "field": "state.position.z", "op": ">", "value": -8},
        {"type": "entity_field", "select": "by_id", "id": "imp_e",
         "field": "state.position.x", "op": "<", "value": 2.5}
      ]
    },

    {
      "name": "single_monster_long_run",
      "_": "ONE imp, 200 ticks, no spawn pressure. Should reach player and trigger contact removal.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0]},
          "clock_outer": {"spawn_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_imp", "id": "lone_imp", "position": [10, 0, 5]}
        ]
      },
      "actions": [],
      "ticks": 200,
      "assertions": [
        {"type": "entity_count", "query": {"tags_all": ["monster"], "tags_none": ["pillar"]},
         "op": "==", "value": 0},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "_section": "=== AI: RANGER ===",
      "name": "ranger_fire_damages_player",
      "_": "Ranger at distance 5 (within fire_range=6). After 80 ticks ranger fires bullets, player HP < 100.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "hp": 100},
          "clock_outer": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_ranger", "id": "test_ranger", "position": [5, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 80,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<", "value": 100}
      ]
    },

    {
      "name": "ranger_holds_position_when_in_range",
      "_": "Ranger plants when distance ≤ fire_range. Spawn at distance 5; after 30 ticks ranger should not have crossed into kamikaze range (still ≥ 4m from player).",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0},
          "clock_outer": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "monster_ranger", "id": "stand_ranger", "position": [5, 0, 0]}
        ]
      },
      "actions": [],
      "ticks": 30,
      "assertions": [
        {"type": "entity_field", "select": "by_id", "id": "stand_ranger",
         "field": "state.position.x", "op": ">", "value": 4.0}
      ]
    },

    {
      "name": "enemy_bullet_damages_player",
      "_": "Spawn enemy_bullet on top of player. Contact rule fires → -10 HP.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "position": [0, 0, 0], "ammo": 0, "hp": 100},
          "clock_outer": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        },
        "spawn": [
          {"def": "enemy_bullet", "id": "test_eb", "position": [0.5, 0.5, 0]}
        ]
      },
      "actions": [],
      "ticks": 3,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "<=", "value": 90}
      ]
    },

    {
      "_section": "=== WALLS / MOVEMENT ===",
      "name": "wall_blocks_player",
      "_": "ADR 0004: walking west into chamber 2-style west wall (x=-22, blocks_motion). Note: starting chamber is 'outer' (28×28m), but tests load with persistent player + outer's smaller walls at ±14. Use chamber 1 wall: walking into x=-14 should stop player. Adjusted bound: x > -14.",
      "setup": {
        "entity_state": {
          "player": {"facing": -1.5708, "pitch": 0, "ammo": 0, "position": [-10, 0, 0]},
          "clock_outer": {"spawn_timer": 99999.0, "demon_timer": 99999.0, "ranger_timer": 99999.0, "pickup_timer": 99999.0}
        }
      },
      "actions": [
        {"tick": 1, "input": "move_north"}, {"tick": 2, "input": "move_north"},
        {"tick": 3, "input": "move_north"}, {"tick": 4, "input": "move_north"},
        {"tick": 5, "input": "move_north"}, {"tick": 6, "input": "move_north"},
        {"tick": 7, "input": "move_north"}, {"tick": 8, "input": "move_north"},
        {"tick": 9, "input": "move_north"}, {"tick": 10, "input": "move_north"},
        {"tick": 15, "input": "move_north"}, {"tick": 20, "input": "move_north"},
        {"tick": 25, "input": "move_north"}, {"tick": 30, "input": "move_north"},
        {"tick": 40, "input": "move_north"}, {"tick": 50, "input": "move_north"},
        {"tick": 60, "input": "move_north"}
      ],
      "ticks": 60,
      "assertions": [
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.position.x", "op": ">", "value": -14.0}
      ]
    },


        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.hp", "op": "==", "value": 37},
        {"type": "entity_field", "select": "first",
         "query": {"tags_all": ["player"]},
         "field": "state.ammo", "op": "==", "value": 12},

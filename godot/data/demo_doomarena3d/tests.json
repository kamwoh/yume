    {
      "_section": "=== WEAPONS (V2.5 ARSENAL) ===",
      "name": "weapon_switch_changes_state",
      "_": "Pressing weapon_2 sets player.current_weapon = 2.",
      "setup": {
        "entity_state": {
          "player": {"facing": 0, "pitch": 0, "ammo": 30, "current_weapon": 1, "position": [0, 0, 0]},

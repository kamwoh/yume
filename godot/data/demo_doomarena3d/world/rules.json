{
  "_comment": "DoomArena3D WORLD physics (ADR 0009 Phase 3b). 3D movement, weapon firing, AI homing/ranger fire, contact damage/pickup, weapon + ranger cooldowns, monster death animation. Scoring + wave/spawn pacing live in game/rules.json.",
  "rules": [
    {
      "_comment": "=== PLAYER MOVEMENT \u2014 velocity_add_relative for diagonal-friendly motion. Per-tick add of 2.0 with drag=8 + tick=0.05 \u2192 equilibrium ~3.0 m/s. Marine pace.",
      "id": "move_forward",
      "trigger": {
        "type": "input",
        "action": "move_north"
      },
      "effect": {
        "type": "velocity_add_relative",
        "target": "actor",
        "forward": "2.0 * actor.state.speed_multiplier",
        "strafe": 0
      }
    },
    {
      "id": "move_back",
      "trigger": {
        "type": "input",
        "action": "move_south"
      },
      "effect": {
        "type": "velocity_add_relative",
        "target": "actor",
        "forward": "-2.0 * actor.state.speed_multiplier",
        "strafe": 0
      }
    },
    {
      "id": "strafe_right",
      "trigger": {
        "type": "input",
        "action": "move_east"
      },
      "effect": {
        "type": "velocity_add_relative",
        "target": "actor",
        "forward": 0,
        "strafe": "2.0 * actor.state.speed_multiplier"
      }
    },
    {
      "id": "strafe_left",
      "trigger": {
        "type": "input",
        "action": "move_west"
      },
      "effect": {
        "type": "velocity_add_relative",
        "target": "actor",
        "forward": 0,
        "strafe": "-2.0 * actor.state.speed_multiplier"
      }
    },
    {
      "_comment": "=== WEAPON SWITCH \u2014 PRESS-edge. Doesn't reset cooldown.",
      "id": "weapon_switch_1",
      "trigger": {
        "type": "input",
        "action": "weapon_1"
      },
      "query": {
        "tags_all": [
          "player"
        ]
      },
      "effect": [
        {
          "type": "state_set",
          "target": "self",
          "field": "current_weapon",
          "value": 1
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "build"
        }
      ]
    },
    {
      "id": "weapon_switch_2",
      "trigger": {
        "type": "input",
        "action": "weapon_2"
      },
      "query": {
        "tags_all": [
          "player"
        ]
      },
      "effect": [
        {
          "type": "state_set",
          "target": "self",
          "field": "current_weapon",
          "value": 2
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "build"
        }
      ]
    },
    {
      "id": "weapon_switch_3",
      "trigger": {
        "type": "input",
        "action": "weapon_3"
      },
      "query": {
        "tags_all": [
          "player"
        ]
      },
      "effect": [
        {
          "type": "state_set",
          "target": "self",
          "field": "current_weapon",
          "value": 3
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "build"
        }
      ]
    },
    {
      "_comment": "=== FIRE PLASMA (current_weapon=1). PRESS-edge. Bullet spawns at eye level, velocity = forward \u00d7 22. Cost 1 ammo, no cooldown.",
      "id": "fire_plasma",
      "trigger": {
        "type": "input",
        "action": "spark"
      },
      "query": {
        "tags_all": [
          "player"
        ],
        "state": {
          "ammo_gt": 0,
          "current_weapon": 1,
          "weapon_cooldown_lte": 0
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "bullet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing) * cos(self.state.pitch) * 22",
                "sin(self.state.pitch) * 22",
                "-cos(self.state.facing) * cos(self.state.pitch) * 22"
              ]
            }
          }
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "ammo",
          "amount": -1
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "shoot"
        }
      ]
    },
    {
      "_comment": "=== FIRE SHOTGUN (current_weapon=2). 5 pellets in \u00b115\u00b0 spread. Cost 3 ammo. Cooldown 8 ticks.",
      "id": "fire_shotgun",
      "trigger": {
        "type": "input",
        "action": "spark"
      },
      "query": {
        "tags_all": [
          "player"
        ],
        "state": {
          "ammo_gte": 3,
          "current_weapon": 2,
          "weapon_cooldown_lte": 0
        }
      },
      "effect": [
        {
          "type": "spawn",
          "template": "bullet_pellet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing - 0.262) * cos(self.state.pitch) * 18",
                "sin(self.state.pitch) * 18",
                "-cos(self.state.facing - 0.262) * cos(self.state.pitch) * 18"
              ]
            }
          }
        },
        {
          "type": "spawn",
          "template": "bullet_pellet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing - 0.131) * cos(self.state.pitch) * 18",
                "sin(self.state.pitch) * 18",
                "-cos(self.state.facing - 0.131) * cos(self.state.pitch) * 18"
              ]
            }
          }
        },
        {
          "type": "spawn",
          "template": "bullet_pellet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing) * cos(self.state.pitch) * 18",
                "sin(self.state.pitch) * 18",
                "-cos(self.state.facing) * cos(self.state.pitch) * 18"
              ]
            }
          }
        },
        {
          "type": "spawn",
          "template": "bullet_pellet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing + 0.131) * cos(self.state.pitch) * 18",
                "sin(self.state.pitch) * 18",
                "-cos(self.state.facing + 0.131) * cos(self.state.pitch) * 18"
              ]
            }
          }
        },
        {
          "type": "spawn",
          "template": "bullet_pellet",
          "position": [
            "self.state.position.x - sin(self.state.facing) * cos(self.state.pitch) * 0.6",
            "1.6 + sin(self.state.pitch) * 0.6",
            "self.state.position.z - cos(self.state.facing) * cos(self.state.pitch) * 0.6"
          ],
          "overrides": {
            "state": {
              "velocity": [
                "-sin(self.state.facing + 0.262) * cos(self.state.pitch) * 18",
                "sin(self.state.pitch) * 18",
                "-cos(self.state.facing + 0.262) * cos(self.state.pitch) * 18"
              ]
            }
          }
        },
        {
          "type": "state_add",
          "target": "self",
          "field": "ammo",
          "amount": -3
        },
        {
          "type": "state_set",
          "target": "self",
          "field": "weapon_cooldown",
          "value": 8
        },
        {
          "type": "emit_shell_event",
          "event": "play_sound",
          "name": "shotgun_blast"
        }
      ]
    },
    {
      "_comment": "=== FIRE ROCKET (current_weapon=3). Single bigger bolt. 3 damage. Cost 5 ammo. Cooldown 15 ticks.",
      "id": "fire_rocket",
      "trigger": {
        "type": "input",
        "action": "spark"
      },
      "query": {
        "tags_all": [
          "player"
        ],
        "state": {
          "ammo_gte": 5,
          "current_weapon": 3,
          "weapon_cooldown_lte": 0

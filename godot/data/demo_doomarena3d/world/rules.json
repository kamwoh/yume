        },
        {
          "type": "spawn",
          "template": "particle_spark",
          "position": [
            "self.state.position.x",
            0.8,
            "self.state.position.z"
          ],
          "overrides": {
            "state": {
              "velocity": [
                -1.5,
                1.0,
                1.5
              ]
            }
          }
        },
        {
          "type": "spawn",
          "template": "particle_spark",
          "position": [
            "self.state.position.x",
            0.8,
            "self.state.position.z"
          ],
          "overrides": {
            "state": {
              "velocity": [
                1.5,

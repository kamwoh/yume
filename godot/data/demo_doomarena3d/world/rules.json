    {
      "_comment": "Projectiles count down their lifetime each tick (state_init lifetime: plasma 24 / pellet 12 / rocket 36) so missed shots that stop against a wall don't accumulate.",
      "id": "bullet_age",
      "trigger": {
        "type": "tick",
        "interval": 1
      },
      "query": {
        "tags_all": [
          "bullet"
        ]
      },

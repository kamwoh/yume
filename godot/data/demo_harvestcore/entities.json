{
  "_comment": "HarvestCore entity definitions and initial world layout. Core loop: till dirt → plant seeds → water daily → harvest mature crops → deposit produce for gold. Season cycle (28 days) forces crop rotation. Animals produce outputs when fed. 4 ambient NPCs walk schedules. Total: 27 entity defs, 82 initial instances (2 meta + 1 player + 3 structures + 3 animals + 4 NPCs + 1 sell_chest + 64 tiles + 4 demo crops).",

  "definitions": [

    {
      "_comment": "Singleton meta entity. world.* bindings read off the entity tagged world_state. ticks_per_day is a static property that dawn_advance_day reads to set its tick interval.",
      "id": "world_clock",
      "tags": ["meta", "world_state"],
      "properties": {
        "ticks_per_day": 60
      },
      "state_init": {
        "time_of_day": 0.0,
        "day": 0,
        "season": 0,
        "weather": 0
      },
      "visual": {"shape": "world_clock", "params": {"sun": "#ffd34a", "ray": "#f4b830"}}
    },

    {
      "_comment": "Singleton economy tracker. Gold is the visible score: unbounded accumulation (no spend mechanic in this GDD scope).",
      "id": "farm_ledger",
      "tags": ["meta", "economy"],
      "state_init": {
        "gold": 0
      },
      "visual": {"shape": "farm_ledger", "params": {"coin": "#d4a030", "inner": "#e8c050", "shine": "#fff0a0"}}
    },

    {
      "_comment": "Unworked ground tile. Hoe tool transforms it to tilled_soil. Tagged tillable so hoe_till query can target it while ignoring already-tilled tiles.",
      "id": "dirt_tile",
      "tags": ["ground", "tillable"],
      "state_init": {
        "tilled": 0
      },
      "visual": {"shape": "dirt_tile", "params": {"base": "#c0955a", "patch": "#a87840"}}
    },

    {
      "_comment": "Post-hoe tile. Tagged plantable so plant_seed rule can find it. occupied=1 while a crop is on it; prevents double-planting. watered resets each dawn unless rainy.",
      "id": "tilled_soil",
      "tags": ["ground", "tilled", "plantable"],
      "state_init": {
        "watered": 0,
        "occupied": 0
      },
      "visual": {"shape": "tilled_soil", "params": {"soil": "#7a4e1e", "furrow": "#5a3610"}}
    },

    {
      "_comment": "CROP STAGE DEFS — shared defs, crop_type + season_mask + grow_rate differentiate via override_properties on each instance. season_mask bitmask: 1=Spring,2=Summer,4=Autumn,8=Winter. Default is radish (Spring).",
      "id": "crop_seed",
      "tags": ["crop", "planted_crop", "crop_stage_seed"],
      "properties": {
        "crop_type": "radish",
        "season_mask": 1,
        "grow_rate": 5
      },
      "state_init": {
        "growth": 0,
        "watered": 0,
        "season_valid": 0
      },
      "visual": {"shape": "crop_seed", "params": {"seed": "#7a5030", "seed_hi": "#a07050"}}
    },

    {
      "id": "crop_young",
      "tags": ["crop", "planted_crop", "crop_stage_young"],
      "properties": {
        "crop_type": "radish",
        "season_mask": 1,
        "grow_rate": 5
      },
      "state_init": {
        "growth": 100,
        "watered": 0,
        "season_valid": 0
      },
      "visual": {"shape": "crop_young", "params": {"stem": "#5a8a3a", "leaf": "#6db85a", "tip": "#8ed870"}}
    },

    {
      "_comment": "harvestable tag on mature crops is what gates the scythe harvest rules. After transform from crop_young the tag appears automatically.",
      "id": "crop_mature",
      "tags": ["crop", "planted_crop", "crop_stage_mature", "harvestable"],
      "properties": {
        "crop_type": "radish",
        "season_mask": 1,
        "grow_rate": 5
      },
      "state_init": {
        "growth": 200,
        "watered": 0,
        "season_valid": 0
      },
      "visual": {"shape": "crop_mature", "params": {"stem": "#5a8a3a", "foliage": "#7eb85a", "head": "#c8b030", "head_hi": "#e8d050"}}
    },

    {
      "_comment": "Out-of-season plants transform here on season boundary. No growth rules apply. Player hoes it back to dirt via hoe_remove_dead rule.",
      "id": "dead_crop",
      "tags": ["crop", "dead"],
      "state_init": {
        "growth": 0
      },
      "visual": {"shape": "dead_crop", "params": {"stalk": "#5a4a38", "husk": "#7a6a58", "droop": "#6a5848"}}
    },


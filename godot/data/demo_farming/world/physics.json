{
  "_comment": "W5.2 farming demo rules. Player WASD movement (input rules). Crops grow autonomously through stages. Player harvests mature crops on contact (relate held_by). Villagers wander randomly. Composite buildings render via shape/mesh primitives in shapes.json/meshes.json.",

  "rules": [
    {
      "id": "move_north",
      "trigger": {"type": "input", "action": "move_north"},
      "effect": {"type": "velocity_set", "target": "actor", "x": 0, "y": -90}
    },
    {
      "id": "move_south",
      "trigger": {"type": "input", "action": "move_south"},
      "effect": {"type": "velocity_set", "target": "actor", "x": 0, "y": 90}
    },
    {
      "id": "move_east",
      "trigger": {"type": "input", "action": "move_east"},
      "effect": {"type": "velocity_set", "target": "actor", "x": 90, "y": 0}
    },
    {
      "id": "move_west",
      "trigger": {"type": "input", "action": "move_west"},
      "effect": {"type": "velocity_set", "target": "actor", "x": -90, "y": 0}
    },
    {
      "id": "stop",
      "trigger": {"type": "input", "action": "stop"},
      "effect": {"type": "velocity_set", "target": "actor", "x": 0, "y": 0}
    },

    {
      "id": "crop_grows",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_any": ["crop"], "state": {"growth_lt": 400}},
      "effect": {"type": "state_add", "target": "self", "field": "growth", "amount": 4}
    },
    {
      "id": "seed_to_young",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["seed"], "state": {"growth_gte": 100}},
      "effect": {"type": "transform", "target": "self", "to": "crop_young"}
    },
    {
      "id": "young_to_mature",
      "trigger": {"type": "tick", "interval": 1},
      "query": {"tags_all": ["young"], "state": {"growth_gte": 200}},
      "effect": {"type": "transform", "target": "self", "to": "crop_mature"}
    },

    {
      "id": "player_harvests_crop",
      "trigger": {"type": "contact"},
      "query": {
        "a": {"tags_all": ["player"]},
        "b": {"tags_all": ["harvestable"]},
        "radius": 35.0
      },
      "effect": [
        {
          "type": "spawn",
          "template": "food_wheat",
          "position": "a"
        },
        {"type": "remove", "target": "b"}
      ]
    },

    {
      "id": "villager_iris_wanders",
      "trigger": {"type": "tick", "interval": 4},
      "query": {"tags_all": ["named"]},
      "effect": {
        "type": "velocity_set",
        "target": "self",
        "x": "(randf() - 0.5) * 50",
        "y": "(randf() - 0.5) * 50"
      }
    }
  ]
}

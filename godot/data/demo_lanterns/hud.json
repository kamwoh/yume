{
  "_comment": "GAME layer (ADR 0067): lantern counter + win block. Game-owned (compose_shell/compose_world don't write hud.json).",
  "panels": [
    {
      "anchor": "top-center",
      "width": 260,
      "height": 28,
      "x_offset": 0,
      "y_offset": 14,
      "align": "center",
      "elements": [
        {
          "type": "label",
          "binds": "game_state.collected",
          "format": "Lanterns {} / 3",
          "size": 18,
          "color": "#ffd479",
          "bold": true,
          "shadow": true,
          "align": "center"
        }
      ]
    },
    {
      "_comment": "DEBUG camera-tuning readout (live world_clock cam_* values). Remove with 30_camera_tune.json once good values are baked into scene.json.",
      "anchor": "top-left",
      "width": 240,
      "height": 130,
      "x_offset": 12,
      "y_offset": 12,
      "elements": [
        {"type": "label", "text": "Camera tuning", "size": 14, "color": "#9fd0ff", "bold": true, "shadow": true},
        {"type": "label", "text": "P/O proj   K/J ortho   N/M fov", "size": 12, "color": "#cfe6ff", "shadow": true},
        {"type": "label", "binds": "world_clock.cam_ortho", "format": "Ortho mode: {}  (1=ortho)", "size": 13, "color": "#ffffff", "shadow": true},
        {"type": "label", "binds": "world_clock.cam_ortho_size", "format": "Ortho size: {}  (ortho only)", "size": 13, "color": "#ffffff", "shadow": true},
        {"type": "label", "binds": "world_clock.cam_fov", "format": "FOV: {}  (persp only)", "size": 13, "color": "#ffffff", "shadow": true}
      ]
    }
  ],
  "win": {
    "_comment": "Win: all three lanterns collected.",
    "binds": "game_state.collected",
    "op": ">=",
    "value": 3,
    "message": "You gathered all three lost lanterns before nightfall."
  }
}

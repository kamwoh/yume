  {
   "name": "variant_no_move_counter_disables_track_moves",
   "_": "ADR 0009 Phase 2d. Variant 'no_move_counter' overrides track_moves rule's chance to 0.0. Player walks N then S (2 moves) \u2014 without the override, clock.moves=2; with it, clock.moves=0. Also asserts world_state.variant_active was overlaid.",
   "variant": "no_move_counter",
   "setup": {},
   "steps": [
    {
     "press": "move_north"
    },
    {
     "tick": 4
    },
    {
     "press": "move_south"
    },
    {
     "tick": 6
    },
    {

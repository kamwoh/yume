        "value": 48
       }
      },
      {
       "entity_field": {
        "query": {
         "tags_all": [
          "player"
         ]
        },
        "field": "state.position.x",
        "op": "==",
        "value": 48
       }
      }
     ]
    }
   ]
  },
  {

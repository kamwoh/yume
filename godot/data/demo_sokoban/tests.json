    {
     "press": "move_south"
    },
    {
     "hold": "move_west",
     "for": 0.3
    },
    {
     "hold": "move_south",
     "for": 0.3
    },
    {
     "hold": "move_east",
     "for": 0.3
    },
    {
     "press": "move_north"
    },
    {
     "hold": "move_west",
     "for": 0.2

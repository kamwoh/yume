// ground_simple_displace.gdshader
//
// Minimal heightmap-displacement ground shader. Used by compose_world.py
// (text-to-world auto-gen) for runnable demos that don't need the full
// 5biome blend logic — semantic map IS the albedo texture, heightmap
// drives vertex Y displacement. Lit by Godot's standard lighting via
// the spatial shader type.
//
// Uniforms (set via scene.json ground.mesh.shader_params):
//   biome_map:  the semantic map PNG (used as albedo)
//   heightmap:  grayscale terrain elevation
//
// Uniforms (set via scene.json ground.mesh):
//   plane_size:    plane width in meters (e.g. 80.0)
//   height_scale:  max displacement in meters (e.g. 2.0)
//   height_offset: signed offset applied before scaling (e.g. -0.5 makes
//                  grey-128 = ground level, brighter = up, darker = down)
//
// Why minimal: aldenmere's full 5biome shader is auto-generated by
// tools/yume_shadergen from a DAG spec — overkill for our case where
// we just want "show the semantic colors + undulate the ground." This
// shader is hand-authored, lives in the lib, reusable across any
// auto-gen game that wants heightmap displacement without biome
// blending.
//
// 2026-05-26 — Yume reuse principle: lib shader, referenced by hash
// path from scene.json.

shader_type spatial;
render_mode blend_mix, cull_back, depth_draw_opaque;

uniform sampler2D biome_map : source_color, filter_linear, repeat_disable;
uniform sampler2D heightmap : source_color, filter_linear, repeat_disable;
uniform float plane_size = 80.0;
uniform float height_scale = 2.0;
uniform float height_offset = -0.5;

varying vec3 v_world_pos;

void vertex() {
    // Map vertex XZ to heightmap UV ((0,0) → (1,1)).
    vec2 hm_uv = vec2(
        (VERTEX.x + plane_size * 0.5) / plane_size,
        1.0 - (VERTEX.z + plane_size * 0.5) / plane_size
    );
    float h = texture(heightmap, hm_uv).r + height_offset;
    VERTEX.y += h * height_scale;

    // Recompute normal via finite differences for correct shading on slopes.
    float eps_uv = 1.0 / 256.0;   // sample resolution; finer = smoother
    float h_xp = texture(heightmap, hm_uv + vec2(eps_uv, 0.0)).r + height_offset;
    float h_xn = texture(heightmap, hm_uv - vec2(eps_uv, 0.0)).r + height_offset;
    float h_zp = texture(heightmap, hm_uv + vec2(0.0, eps_uv)).r + height_offset;
    float h_zn = texture(heightmap, hm_uv - vec2(0.0, eps_uv)).r + height_offset;
    float ds = 2.0 * eps_uv * plane_size;
    vec3 slope_x = vec3(ds, (h_xp - h_xn) * height_scale, 0.0);
    vec3 slope_z = vec3(0.0, (h_zp - h_zn) * height_scale, ds);
    NORMAL = normalize(cross(slope_z, slope_x));

    v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
    // Sample the semantic map as the albedo. World-space UV (re-derived
    // from v_world_pos to match the heightmap UV space, so semantic
    // colors stay locked to their world positions even as the ground
    // displaces vertically).
    vec2 albedo_uv = vec2(
        (v_world_pos.x + plane_size * 0.5) / plane_size,
        1.0 - (v_world_pos.z + plane_size * 0.5) / plane_size
    );
    ALBEDO = texture(biome_map, albedo_uv).rgb;
    ROUGHNESS = 0.92;
    METALLIC = 0.0;
}

// AUTO-GENERATED by tools/yume_shadergen from
//   {{ template_path }}
//   spec: {{ spec_path }}
// DO NOT EDIT — change the template or the per-game spec instead.
//
// {{ n_biomes }}-biome ground shader. Implements ADR 0055 (multi-biome
// ground from semantic map) via ADR 0058 (shader as JSON, Phase A).
//
// Biomes: {{ biome_names | join(', ') }}
{% if features.water_animation %}// Water animation: ENABLED (speed={{ features.water_animation.speed }}, amplitude={{ features.water_animation.amplitude }}){% endif %}
{% if features.displacement %}// Heightmap displacement: ENABLED (scale={{ features.displacement.scale }}){% endif %}

shader_type spatial;
render_mode blend_mix, cull_back, depth_draw_opaque;

// Biome map — the semantic top-down PNG. Sampled in world-space via
// the v_world_pos varying (see vertex() / fragment() below).
uniform sampler2D biome_map : source_color, filter_linear, repeat_disable;

// {{ n_biomes }} biome reference colors (RGB matters; alpha unused).
// Embedded as compile-time constants from the per-game spec.
{% for b in biomes %}
const vec3 BIOME_COLOR_{{ b.name | upper }} = vec3({{ b.color[0] }}, {{ b.color[1] }}, {{ b.color[2] }});
{% endfor %}

// {{ n_biomes }} tileable albedo textures.
{% for b in biomes %}
uniform sampler2D albedo_{{ b.name }} : source_color, filter_linear_mipmap, repeat_enable;
{% endfor %}

// Per-biome roughness + metallic — embedded as compile-time constants.
{% for b in biomes %}
const float ROUGHNESS_{{ b.name | upper }} = {{ b.roughness }};
const float METALLIC_{{ b.name | upper }}  = {{ b.metallic }};
{% endfor %}

uniform float plane_size = {{ features.plane_size | default(80.0) }};
uniform float uv_tile : hint_range(1.0, 200.0) = {{ features.uv_tile | default(30.0) }};
uniform float blend_softness : hint_range(0.05, 2.0) = {{ features.blend_softness | default(0.5) }};

{% if features.water_animation -%}
// Water-only animated UV scroll. Set water_scroll_amplitude=0 to
// disable (e.g., frozen lake variant of the same template).
uniform float water_scroll_speed : hint_range(0.0, 1.0) = {{ features.water_animation.speed }};
uniform float water_scroll_amplitude : hint_range(0.0, 0.5) = {{ features.water_animation.amplitude }};
{% endif %}

{% if features.displacement -%}
// Heightmap vertex displacement. height_scale=0 disables.
uniform sampler2D heightmap : source_color, filter_linear, repeat_disable;
uniform float height_scale : hint_range(0.0, 5.0) = {{ features.displacement.scale }};
uniform float height_offset : hint_range(-1.0, 1.0) = {{ features.displacement.offset }};
{% endif %}

// World-space position carried from vertex() to fragment(). REQUIRED
// because Godot 4's `VERTEX` in fragment() is view-space — using it
// directly would make the biome regions drift with the camera.
varying vec3 v_world_pos;

void vertex() {
{% if features.displacement -%}
    // Heightmap displacement. Sample heightmap at the vertex's world-XZ
    // → biome UV. PlaneMesh PRE-displacement: VERTEX is in model space
    // = world space, so use VERTEX.xz directly.
    vec2 hm_uv = vec2(
        (VERTEX.x + plane_size * 0.5) / plane_size,
        1.0 - (VERTEX.z + plane_size * 0.5) / plane_size
    );
    float h_center = texture(heightmap, hm_uv).r + height_offset;
    VERTEX.y += h_center * height_scale;

    // 4-neighbor finite-difference normal from heightmap slope.
    float eps_uv = 1.0 / 1024.0;
    float h_xp = texture(heightmap, hm_uv + vec2(eps_uv, 0.0)).r + height_offset;
    float h_xn = texture(heightmap, hm_uv - vec2(eps_uv, 0.0)).r + height_offset;
    float h_zp = texture(heightmap, hm_uv + vec2(0.0, eps_uv)).r + height_offset;
    float h_zn = texture(heightmap, hm_uv - vec2(0.0, eps_uv)).r + height_offset;
    float ds = 2.0 * eps_uv * plane_size;
    vec3 slope_x = vec3(ds, (h_xp - h_xn) * height_scale, 0.0);
    vec3 slope_z = vec3(0.0, (h_zp - h_zn) * height_scale, ds);
    NORMAL = normalize(cross(slope_z, slope_x));
{% endif %}
    v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
    // === Biome lookup (world-space) ===
    vec2 biome_uv = vec2(
        (v_world_pos.x + plane_size * 0.5) / plane_size,
        1.0 - (v_world_pos.z + plane_size * 0.5) / plane_size
    );
    vec3 biome_pixel = texture(biome_map, biome_uv).rgb;

    // === Color-distance to each biome reference ===
{% for b in biomes %}
    float d_{{ b.name }} = distance(biome_pixel, BIOME_COLOR_{{ b.name | upper }});
{% endfor %}

    // === Tiled albedos ===
    vec2 tex_uv = UV * uv_tile;
{% if features.water_animation -%}
    // Animated UV warp — only applied to biomes flagged animate=true
    // (typically water). Two crossed scrolls at different rates +
    // spatial offset so adjacent samples shift out of phase.
    vec2 anim_uv = tex_uv + vec2(
        sin(TIME * water_scroll_speed + v_world_pos.x * 0.18) * water_scroll_amplitude,
        cos(TIME * water_scroll_speed * 0.73 + v_world_pos.z * 0.18) * water_scroll_amplitude
    );
{% endif %}
{% for b in biomes %}
{% if b.animate -%}
    vec3 a_{{ b.name }} = texture(albedo_{{ b.name }}, anim_uv).rgb;
{% else -%}
    vec3 a_{{ b.name }} = texture(albedo_{{ b.name }}, tex_uv).rgb;
{% endif %}
{% endfor %}

    // === Soft-min blend ===
    // Each biome's weight = max(0.001, blend_softness - distance)^2.
{% for b in biomes %}
    float w_{{ b.name }} = pow(max(0.001, blend_softness - d_{{ b.name }}), 2.0);
{% endfor %}
    float wsum = {% for b in biomes %}w_{{ b.name }}{% if not loop.last %} + {% endif %}{% endfor %};

    ALBEDO = ({% for b in biomes %}a_{{ b.name }} * w_{{ b.name }}{% if not loop.last %}
            + {% endif %}{% endfor %}) / wsum;

    ROUGHNESS = ({% for b in biomes %}ROUGHNESS_{{ b.name | upper }} * w_{{ b.name }}{% if not loop.last %}
               + {% endif %}{% endfor %}) / wsum;
    METALLIC  = ({% for b in biomes %}METALLIC_{{ b.name | upper }}  * w_{{ b.name }}{% if not loop.last %}
               + {% endif %}{% endfor %}) / wsum;
}

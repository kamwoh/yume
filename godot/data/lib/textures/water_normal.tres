[gd_resource type="NoiseTexture2D" load_steps=2 format=3]

; Seamless multi-octave noise normal map for the stylized water shader.
; Equivalent to the YouTube tutorial's NoiseTexture2D + FastNoiseLite +
; seamless + as_normal_map setup. Stacking 5 octaves (lacunarity 2.0,
; gain 0.5) breaks up the obvious repetition that a single-frequency
; value-noise has — the water surface stops looking "tiled."

[sub_resource type="FastNoiseLite" id="FastNoiseLite_water"]
noise_type = 1
seed = 7
frequency = 0.04
fractal_octaves = 5
fractal_lacunarity = 2.0
fractal_gain = 0.5

[resource]
width = 512
height = 512
seamless = true
as_normal_map = true
bump_strength = 8.0
noise = SubResource("FastNoiseLite_water")

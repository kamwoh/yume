{
  "_comment": "ADR 0027 — input bundle: WASD with first-person variant. 8 rules total: 4 world-frame (active when world_clock.camera_mode != first_person_3d) + 4 camera-relative (active when camera_mode == first_person_3d). Per-game physics.json splices via {$include: '@lib.input_bundles.wasd_with_fp_variant.rules'}. Action declarations under `actions` are FOR DOCUMENTATION; per-game ui/input.json still authors its own action list (the canonical InputMap declarations).",

  "actions": [
    {"name": "move_north", "edge": "hold", "_doc": "W key (canonical: ui/input.json)"},
    {"name": "move_south", "edge": "hold", "_doc": "S key"},
    {"name": "move_east",  "edge": "hold", "_doc": "D key"},
    {"name": "move_west",  "edge": "hold", "_doc": "A key"}
  ],

  "rules": [
    {
      "_comment": "World-frame WASD — fires when camera is NOT first_person_3d. W=north regardless of player facing. Spliced into game's physics.json rules array.",
      "id": "lib_wasd_move_north_world",
      "trigger": {"type": "input", "action": "move_north"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_ne": "first_person_3d"}},
      "effect": {"type": "velocity_set", "target": "actor", "x": 0, "y": -3.0}
    },
    {
      "id": "lib_wasd_move_south_world",
      "trigger": {"type": "input", "action": "move_south"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_ne": "first_person_3d"}},
      "effect": {"type": "velocity_set", "target": "actor", "x": 0, "y": 3.0}
    },
    {
      "id": "lib_wasd_move_east_world",
      "trigger": {"type": "input", "action": "move_east"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_ne": "first_person_3d"}},
      "effect": {"type": "velocity_set", "target": "actor", "x": 3.0, "y": 0}
    },
    {
      "id": "lib_wasd_move_west_world",
      "trigger": {"type": "input", "action": "move_west"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_ne": "first_person_3d"}},
      "effect": {"type": "velocity_set", "target": "actor", "x": -3.0, "y": 0}
    },
    {
      "_comment": "Camera-relative WASD — fires when camera IS first_person_3d. Engine's velocity_set_relative reads actor.state.facing (mouse-driven by _camera_first_person_3d's _drain_mouse_facing) and rotates forward/strafe into world XZ. W=mouse-aim-forward, S=back, A=strafe-left, D=strafe-right.",
      "id": "lib_wasd_move_forward_fp",
      "trigger": {"type": "input", "action": "move_north"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_eq": "first_person_3d"}},
      "effect": {"type": "velocity_set_relative", "target": "actor", "forward": 3.0, "strafe": 0}
    },
    {
      "id": "lib_wasd_move_back_fp",
      "trigger": {"type": "input", "action": "move_south"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_eq": "first_person_3d"}},
      "effect": {"type": "velocity_set_relative", "target": "actor", "forward": -3.0, "strafe": 0}
    },
    {
      "id": "lib_wasd_strafe_right_fp",
      "trigger": {"type": "input", "action": "move_east"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_eq": "first_person_3d"}},
      "effect": {"type": "velocity_set_relative", "target": "actor", "forward": 0, "strafe": 3.0}
    },
    {
      "id": "lib_wasd_strafe_left_fp",
      "trigger": {"type": "input", "action": "move_west"},
      "query": {"tags_all": ["world_clock"], "state": {"camera_mode_eq": "first_person_3d"}},
      "effect": {"type": "velocity_set_relative", "target": "actor", "forward": 0, "strafe": -3.0}
    }
  ]
}

      ],
      "params": {
        "blade":      "#588040",
        "blade_dark": "#3a6028"
      }
    },

    "deer_3d": {
      "_comment": "Quadruped buck — 4 legs, elongated body, neck, head, simple antlers. ~1.6m tall at antler tips, ~1.0m at back, ~1.5m long. Faces +X by default (head pokes out +X). Warm-brown coat. Reads unambiguously as a 4-legged animal — not human.",
      "primitives": [
        {"op": "cylinder", "pos": [ 0.4, 0.35,  0.17], "radius": 0.07, "height": 0.7, "color": "$leg"},
        {"op": "cylinder", "pos": [ 0.4, 0.35, -0.17], "radius": 0.07, "height": 0.7, "color": "$leg"},
        {"op": "cylinder", "pos": [-0.4, 0.35,  0.17], "radius": 0.07, "height": 0.7, "color": "$leg"},
        {"op": "cylinder", "pos": [-0.4, 0.35, -0.17], "radius": 0.07, "height": 0.7, "color": "$leg"},
        {"op": "box",      "pos": [ 0.0, 0.92,  0.0 ], "size":   [1.0, 0.45, 0.4], "color": "$coat"},
        {"op": "box",      "pos": [ 0.45, 1.15, 0.0 ], "size":   [0.18, 0.35, 0.18], "color": "$coat"},
        {"op": "box",      "pos": [ 0.6, 1.38,  0.0 ], "size":   [0.3, 0.22, 0.22], "color": "$coat"},
        {"op": "box",      "pos": [ 0.78, 1.35, 0.0 ], "size":   [0.12, 0.14, 0.15], "color": "$snout"},
        {"op": "box",      "pos": [-0.55, 0.95, 0.0 ], "size":   [0.15, 0.15, 0.10], "color": "$tail"},
        {"op": "cylinder", "pos": [ 0.6, 1.65,  0.08], "radius": 0.025, "height": 0.4, "color": "$antler"},
        {"op": "cylinder", "pos": [ 0.6, 1.65, -0.08], "radius": 0.025, "height": 0.4, "color": "$antler"},
        {"op": "cylinder", "pos": [ 0.7, 1.8,   0.15], "radius": 0.02, "height": 0.2, "color": "$antler"},
        {"op": "cylinder", "pos": [ 0.7, 1.8,  -0.15], "radius": 0.02, "height": 0.2, "color": "$antler"}
      ],
      "params": {
        "coat":   "#7a4a28",
        "leg":    "#5a3818",
        "snout":  "#3a2810",
        "tail":   "#d8c8a8",
        "antler": "#c0a070"
      }
    },

    "market_stall_3d": {

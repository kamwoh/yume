# Yume gdlint configuration.
#
# Tweaks the gdtoolkit defaults to match Yume's actual style:
#   - allow underscored function-local vars (Yume convention for
#     private state captured in a function — _dynasty_dir, _ent, etc.)
#   - relax class-definitions-order (Yume groups static helpers at
#     file bottom, not after exports — a deliberate readability choice)
#   - disable max-returns (gdlint default 6 fires on every legitimate
#     guard-style function; early-returns are often clearer than
#     single-return refactors of the same logic)
#   - bump max-file-lines for effect_apply.gd (single dispatch table
#     for all effects) and test_runner.gd (single test entry file)
#   - bump max-public-methods to cover test_runner's growing test list
#
# Run via: tools/check_gdscript.sh
# Or directly: venv/bin/gdlint godot/scripts/

disable:
  - class-definitions-order
  - max-returns

function-variable-name: '_?[a-z][a-z0-9]*(_[a-z0-9]+)*'

max-file-lines: 10000
max-public-methods: 200
max-line-length: 200
# Why 200, not 120: EngineError hint strings + push_warning messages
# carry rich diagnostic context for LLM-agent consumers (qa-tester,
# yume-design orchestrator). Splitting them via string concatenation
# breaks one-grep-finds-it semantics + adds visual noise for the reader.
# Code lines (functions, expressions) still fit easily under 120 — the
# bump only accommodates the deliberate long strings.

<?xml version="1.0"?>
<!-- A two-wheel differential-drive robot in ROS conventions (Z up, X forward).
     The wheel joints roll -90 degrees, as many ROS robot files do, so the
     importer must fold that rotation into the wheel shape and axis. -->
<robot name="diffbot">
  <material name="shell"><color rgba="0.20 0.45 0.85 1"/></material>
  <material name="tire"><color rgba="0.1 0.1 0.12 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual><geometry><box size="0.4 0.3 0.08"/></geometry><material name="shell"/></visual>
    <collision><geometry><box size="0.4 0.3 0.08"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.04"/></geometry><material name="tire"/></visual>
    <collision><geometry><cylinder radius="0.1" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0.1 0.19 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="3.0" velocity="10.0"/>
  </joint>

  <link name="right_wheel">
    <visual><geometry><cylinder radius="0.1" length="0.04"/></geometry><material name="tire"/></visual>
    <collision><geometry><cylinder radius="0.1" length="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0.1 -0.19 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="3.0" velocity="10.0"/>
  </joint>

  <link name="caster">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="tire"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/>
    <origin xyz="-0.15 0 -0.1" rpy="0 0 0"/>
  </joint>
</robot>
